@@ -0,0 +1,84 @@
+package storage
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+)
+
+func TestTaskFlowDriveRefreshSingleFlight(t *testing.T) {
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		r.ParseForm()
+		if r.Form.Get("grant_type") != "refresh_token" || r.Form.Get("client_secret") != "test-secret" {
+			t.Error("wrong token request")
+		}
+		json.NewEncoder(w).Encode(map[string]any{"access_token": "fixture-access", "token_type": "Bearer", "expires_in": 3600, "scope": TaskFlowDriveScope})
+	}))
+	defer server.Close()
+	tok := &TaskFlowDriveOAuthToken{Client: server.Client(), ClientID: "fixture-client", ClientSecret: "test-secret", RefreshToken: "fixture-refresh", endpoint: server.URL}
+	var wg sync.WaitGroup
+	for n := 0; n < 10; n++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			v, e := tok.AccessToken(context.Background())
+			if e != nil || v != "fixture-access" {
+				t.Error("refresh failed")
+			}
+		}()
+	}
+	wg.Wait()
+	if calls != 1 {
+		t.Fatal("refresh duplicated", calls)
+	}
+}
+func TestTaskFlowDriveRefreshRejectsFailures(t *testing.T) {
+	for _, mode := range []string{"revoked", "broad-scope", "rotate", "redirect", "rotate-persist", "rotate-persist-fails"} {
+		t.Run(mode, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch mode {
+				case "revoked":
+					w.WriteHeader(400)
+					fmt.Fprint(w, `{"error":"invalid_grant"}`)
+				case "redirect":
+					w.Header().Set("Location", "https://untrusted.invalid/token")
+					w.WriteHeader(307)
+				case "broad-scope":
+					json.NewEncoder(w).Encode(map[string]any{"access_token": "a", "token_type": "Bearer", "expires_in": 3600, "scope": "https://www.googleapis.com/auth/drive"})
+				case "rotate", "rotate-persist", "rotate-persist-fails":
+					json.NewEncoder(w).Encode(map[string]any{"access_token": "a", "token_type": "Bearer", "expires_in": 3600, "refresh_token": "rotated-fixture"})
+				}
+			}))
+			defer server.Close()
+			tok := &TaskFlowDriveOAuthToken{Client: server.Client(), ClientID: "fixture-client", ClientSecret: "test-secret", RefreshToken: "fixture-refresh", endpoint: server.URL}
+			saved := ""
+			if mode == "rotate-persist" || mode == "rotate-persist-fails" {
+				tok.PersistRefresh = func(_ context.Context, v string) error {
+					if mode == "rotate-persist-fails" {
+						return fmt.Errorf("store unavailable")
+					}
+					saved = v
+					return nil
+				}
+			}
+			access, e := tok.AccessToken(context.Background())
+			if mode == "rotate-persist" {
+				if e != nil || access != "a" || saved != "rotated-fixture" || tok.RefreshToken != saved {
+					t.Fatal("rotation not durably saved", e)
+				}
+			} else if e == nil {
+				t.Fatal("unsafe refresh accepted")
+			}
+			if mode == "rotate-persist-fails" && tok.RefreshToken != "fixture-refresh" {
+				t.Fatal("failed persistence replaced grant")
+			}
+
+		})
+	}
+}
diff --git a/labs/taskflow/patches/drive-attachments/taskflow_drive_trash.go b/labs/taskflow/patches/drive-attachments/taskflow_drive_trash.go
new file mode 100644
index 0000000..0039854
--- /dev/null
+++ b/labs/taskflow/patches/drive-attachments/taskflow_drive_trash.go
@@ -0,0 +1,136 @@
+package storage
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"log/slog"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Outbox rows are created by the attachment DELETE transaction. The worker
+// cannot manufacture a request to delete an arbitrary Drive file.
+type TaskFlowDriveTrashIndex interface {
+	PendingTrash(context.Context, int) ([]string, error)
+	TrashBinding(context.Context, string) (TaskFlowDriveBinding, error)
+	MarkTrashed(context.Context, string) error
+}
+
+func (i TaskFlowSQLDriveIndex) PendingTrash(ctx context.Context, limit int) ([]string, error) {
+	var data []byte
+	e := i.DB.QueryRow(ctx, `SELECT coalesce(json_agg(object_key),'[]'::json) FROM (SELECT object_key FROM taskflow.attachment_drive_delete_queue WHERE NOT done ORDER BY queued_at LIMIT $1)x`, limit).Scan(&data)
+	if e != nil {
+		return nil, e
+	}
+	var keys []string
+	e = json.Unmarshal(data, &keys)
+	return keys, e
+}
+func (i TaskFlowSQLDriveIndex) TrashBinding(ctx context.Context, key string) (TaskFlowDriveBinding, error) {
+	b := TaskFlowDriveBinding{Key: key}
+	e := i.DB.QueryRow(ctx, `SELECT file_id,sha256,folder_id,size_bytes,ready,deleted FROM taskflow.claim_drive_trash($1)`, key).Scan(&b.FileID, &b.SHA256, &b.FolderID, &b.Size, &b.Ready, &b.Deleted)
+	return b, e
+}
+func (i TaskFlowSQLDriveIndex) MarkTrashed(ctx context.Context, key string) error {
+	_, e := i.DB.Exec(ctx, `UPDATE taskflow.attachment_drive_delete_queue SET done=true,finished_at=clock_timestamp() WHERE object_key=$1`, key)
+	return e
+}
+func (s *TaskFlowDriveStorage) tryTrash(ctx context.Context, key string) error {
+	if !s.trashEnabled {
+		return errors.New("Drive trash policy not enabled; original retained")
+	}
+	queue, ok := s.index.(TaskFlowDriveTrashIndex)
+	if !ok {
+		return errors.New("Drive transactional delete queue unavailable")
+	}
+	b, e := queue.TrashBinding(ctx, key)
+	if e != nil {
+		return errors.New("Drive delete is not queued or surviving reference exists")
+	}
+	if !b.Ready || b.FolderID != s.folder || !validDriveID(b.FileID) {
+		return errors.New("unsafe Drive delete binding")
+	}
+	if e = s.checkFolder(ctx); e != nil {
+		return e
+	}
+	r, e := s.request(ctx, http.MethodGet, "/drive/v3/files/"+b.FileID+"?fields=id,size,sha256Checksum,parents,trashed,shared,ownedByMe", nil, "")
+	if e != nil {
+		return e
+	}
+	if r.StatusCode != 200 {
+		closeDriveResponse(r)
+		return ErrTaskFlowDriveUnavailable
+	}
+	var m driveObjectMeta
+	e = json.NewDecoder(io.LimitReader(r.Body, 8192)).Decode(&m)
+	closeDriveResponse(r)
+	if e != nil {
+		return ErrTaskFlowDriveUnavailable
+	}
+	parent := false
+	for _, p := range m.Parents {
+		if p == s.folder {
+			parent = true
+		}
+	}
+	if m.ID != b.FileID || m.Shared == nil || *m.Shared || !m.Owned || !parent || m.SHA256 != b.SHA256 || m.Size != strconv.FormatInt(b.Size, 10) {
+		return errors.New("Drive trash refused: original ownership/integrity changed")
+	}
+	// The queue was committed with the native deletion. Only that unique original
+	// is eligible; no Drive permanent-delete or empty-trash endpoint is used.
+	if !m.Trashed {
+		r, e = s.request(ctx, http.MethodPatch, "/drive/v3/files/"+b.FileID+"?fields=id,trashed", strings.NewReader(`{"trashed":true}`), "application/json")
+		if e != nil {
+			return e
+		}
+		if r.StatusCode != 200 {
+			closeDriveResponse(r)
+			return ErrTaskFlowDriveUnavailable
+		}
+		var result struct {
+			ID      string `json:"id"`
+			Trashed bool   `json:"trashed"`
+		}
+		e = json.NewDecoder(io.LimitReader(r.Body, 8192)).Decode(&result)
+		closeDriveResponse(r)
+		if e != nil || result.ID != b.FileID || !result.Trashed {
+			return ErrTaskFlowDriveUnavailable
+		}
+	}
+	if e = s.index.MarkDeleted(ctx, key); e != nil {
+		return e
+	}
+	return queue.MarkTrashed(ctx, key)
+}
+func (s *TaskFlowDriveStorage) RunTrashWorker(ctx context.Context) {
+	if !s.trashEnabled || s.readOnly {
+		return
+	}
+	queue, ok := s.index.(TaskFlowDriveTrashIndex)
+	if !ok {
+		return
+	}
+	tick := time.NewTicker(time.Hour)
+	defer tick.Stop()
+	for {
+		cycle, cancel := context.WithTimeout(ctx, 45*time.Second)
+		keys, e := queue.PendingTrash(cycle, 10)
+		if e == nil {
+			for _, key := range keys {
+				if e = s.tryTrash(cycle, key); e != nil {
+					slog.Warn("private Drive cleanup remains pending")
+				}
+			}
+		}
+		cancel()
+		select {
+		case <-ctx.Done():
+			return
+		case <-tick.C:
+		}
+	}
+}
diff --git a/labs/taskflow/patches/drive-attachments/taskflow_drive_trash_test.go b/labs/taskflow/patches/drive-attachments/taskflow_drive_trash_test.go
new file mode 100644
index 0000000..ab88ae5
--- /dev/null
+++ b/labs/taskflow/patches/drive-attachments/taskflow_drive_trash_test.go
@@ -0,0 +1,68 @@
+package storage
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+type driveTrashTest struct {
+	*driveIndexTest
+	key                     string
+	queued, done, surviving bool
+}
+
+func (i *driveTrashTest) PendingTrash(context.Context, int) ([]string, error) {
+	if i.queued && !i.done {
+		return []string{i.key}, nil
+	}
+	return nil, nil
+}
+func (i *driveTrashTest) TrashBinding(ctx context.Context, key string) (TaskFlowDriveBinding, error) {
+	if !i.queued || i.done || i.surviving || key != i.key {
+		return TaskFlowDriveBinding{}, errors.New("not eligible")
+	}
+	return i.Lookup(ctx, key)
+}
+func (i *driveTrashTest) MarkTrashed(context.Context, string) error { i.done = true; return nil }
+func TestTaskFlowDriveTransactionalTrash(t *testing.T) {
+	for _, mode := range []string{"success", "outage", "surviving", "unapproved", "shared"} {
+		t.Run(mode, func(t *testing.T) {
+			s, f, original := fixtureDrive(t)
+			ctx := context.Background()
+			key := "workspaces/ws/id"
+			if _, e := s.Upload(ctx, key, []byte("original"), "x", "x"); e != nil {
+				t.Fatal(e)
+			}
+			q := &driveTrashTest{driveIndexTest: original, key: key, queued: true}
+			s.index = q
+			s.trashEnabled = true
+			switch mode {
+			case "outage":
+				f.status = 503
+			case "surviving":
+				q.surviving = true
+			case "unapproved":
+				s.trashEnabled = false
+			case "shared":
+				f.fileShared = true
+			}
+			e := s.DeleteObject(ctx, key)
+			if mode == "success" {
+				if e != nil || !f.trashed || !q.done {
+					t.Fatal("confirmed trash not recorded", e)
+				}
+			} else {
+				if e == nil || f.trashed || q.done {
+					t.Fatal("unsafe trash/success")
+				}
+			}
+			if mode == "outage" {
+				f.status = 0
+				if e = s.tryTrash(ctx, key); e != nil || !f.trashed || !q.done {
+					t.Fatal("durable pending retry failed", e)
+				}
+			}
+		})
+	}
+}
