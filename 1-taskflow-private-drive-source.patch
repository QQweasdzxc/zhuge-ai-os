+#!/usr/bin/env python3
+"""Private Drive backend overlay; never edits the frozen vendor tree."""
+import argparse
+from pathlib import Path
+
+def apply(root,overlay):
+ if 'third_party/multica' in str(root.resolve()):raise SystemExit('frozen vendor refused')
+ router=root/'server/cmd/server/router.go';file=root/'server/internal/handler/file.go'
+ rt=router.read_text();ft=file.read_text()
+ old='\t// Initialize storage with S3 as primary, fallback to local\n\tvar store storage.Storage\n\ts3 := storage.NewS3StorageFromEnv()\n\tif s3 != nil {'
+ new='''\t// Drive is explicit and fails closed, never ephemeral fallback.
+\tvar store storage.Storage
+\tdriveMode:=strings.TrimSpace(os.Getenv("TASKFLOW_ATTACHMENT_STORAGE"))
+\tif driveMode=="drive"||driveMode=="drive-readonly" {
+\t\tctx,cancel:=context.WithTimeout(context.Background(),30*time.Second)
+\t\tprivateDrive,err:=storage.TaskFlowDriveStorageFromEnv(ctx,pool);cancel()
+\t\tif err!=nil{panic("private Drive store is not ready; refusing ephemeral fallback")};store=privateDrive
+\t} else if driveMode!=""&&driveMode!="local" {panic("unsupported storage mode; refusing fallback")
+\t} else if s3:=storage.NewS3StorageFromEnv();s3!=nil {'''
+ callback_old='\t// Health / readiness checks\n'
+ callback_new='''\t// Public OAuth callback carries only expiring single-use state + PKCE.
+\t// All ordinary task/file routes retain their existing authorization.
+\tif driveSetup,err:=storage.TaskFlowDriveSetupFromEnv(pool);err!=nil {
+\t\tpanic("private Drive connection configuration invalid")
+\t} else if driveSetup!=nil {r.Get(storage.TaskFlowDriveCallbackPath,driveSetup.Callback)}
+
+'''+callback_old
+ setup_old='\t\tr.Post("/api/upload-file", h.UploadFile)'
+ setup_new='\t\tr.With(handler.RequireHumanActor).Post("/api/taskflow-drive/setup",h.StartTaskFlowDriveSetup)\n'+setup_old
+ admission_old='\tworkspaceID := h.resolveWorkspaceID(r)\n\n\tr.Body = http.MaxBytesReader(w, r.Body, maxUploadSize)'
+ admission_new='''\tworkspaceID := h.resolveWorkspaceID(r)
+\tif drive,ok:=h.Storage.(*storage.TaskFlowDriveStorage);ok {
+\t\tctx,release,err:=drive.BeginUpload(r.Context());if err!=nil {writeError(w,http.StatusServiceUnavailable,"Drive 附件連線尚未就緒，這次未完成上傳。");return};defer release();r=r.WithContext(ctx)
+\t}
+\tr.Body = http.MaxBytesReader(w, r.Body, maxUploadSize)'''
+ parse_old='\tif err := r.ParseMultipartForm(maxUploadSize); err != nil {'
+ parse_new='\tmultipartMemory:=int64(maxUploadSize);if _,drive:=h.Storage.(*storage.TaskFlowDriveStorage);drive{multipartMemory=1<<20}\n\tif err := r.ParseMultipartForm(multipartMemory); err != nil {'
+ read_old='\tdata, err := io.ReadAll(file)'
+ read_new='\tvar data []byte\n\tif _,drive:=h.Storage.(*storage.TaskFlowDriveStorage);drive{data,err=storage.ReadTaskFlowDriveUpload(file,header.Size)}else{data,err=io.ReadAll(file)}'
+ upload_old='\t\t\tslog.Error("file upload failed", "error", err)\n\t\t\twriteError(w, http.StatusInternalServerError, "upload failed")'
+ upload_new='\t\t\tslog.Error("file upload failed", "error", err)\n\t\t\tif _,drive:=h.Storage.(*storage.TaskFlowDriveStorage);drive{writeError(w,http.StatusServiceUnavailable,"Drive 附件未完成儲存，請稍後再試。");return}\n\t\t\twriteError(w, http.StatusInternalServerError, "upload failed")'
+ metadata_old='\t\t\tslog.Error("failed to create attachment record", "error", err)\n'
+ metadata_new=metadata_old+'\t\t\tif _,drive:=h.Storage.(*storage.TaskFlowDriveStorage);drive{writeError(w,http.StatusServiceUnavailable,"檔案已保留，但任務附件記錄未完成，請稍後重試。");return}\n'
+ reader_old='\t\tslog.Error("failed to open attachment for download", "id", uuidToString(att.ID), "key", key, "error", err)\n'
+ reader_new=reader_old+'\t\tif errors.Is(err,storage.ErrTaskFlowDriveIntegrity){writeError(w,http.StatusBadGateway,"原附件完整性檢查未通過，未顯示可能錯誤的內容。");return}\n\t\tif errors.Is(err,storage.ErrTaskFlowDriveUnavailable){writeError(w,http.StatusServiceUnavailable,"Drive 連線暫時無法使用，原附件記錄仍保留。");return}\n'
+ patches=[(rt,old),(rt,callback_old),(rt,setup_old),(ft,admission_old),(ft,parse_old),(ft,read_old),(ft,upload_old),(ft,metadata_old),(ft,reader_old)]
+ if any(text.count(anchor)!=1 for text,anchor in patches):raise SystemExit('Drive overlay source anchor missing/ambiguous')
+ files={}
+ for source in overlay.glob('*.go'):
+  directory='handler' if '_handler' in source.name else 'storage'
+  dest=(root/'server/cmd/server'/source.name) if '_router' in source.name else (root/'server/internal'/directory/source.name)
+  if dest.exists():raise SystemExit('Drive overlay destination exists')
+  files[dest]=source.read_text()
+ main=root/'server/cmd/server/main.go';mt=main.read_text()
+ main_anchor='\t// Channel inbound supervisor (MUL-3620): holds the §4.4 WS lease per'
+ if mt.count(main_anchor)!=1:raise SystemExit('Drive worker lifetime anchor missing')
+ worker='\t// Private Drive pending-trash retry uses the normal shutdown-bound worker context.\n\tif drive,ok:=h.Storage.(*storage.TaskFlowDriveStorage);ok {go drive.RunTrashWorker(sweepCtx)}\n\n'
+ if mt.count('"github.com/multica-ai/multica/server/internal/selfhosttelemetry"')!=1:raise SystemExit('Drive storage import anchor missing')
+ mt=mt.replace('"github.com/multica-ai/multica/server/internal/selfhosttelemetry"','"github.com/multica-ai/multica/server/internal/selfhosttelemetry"\n"github.com/multica-ai/multica/server/internal/storage"',1).replace(main_anchor,worker+main_anchor,1)
+ main.write_text(mt)
+ router.write_text(rt.replace(old,new,1).replace(callback_old,callback_new,1).replace(setup_old,setup_new,1))
+ file.write_text(ft.replace(admission_old,admission_new,1).replace(parse_old,parse_new,1).replace(read_old,read_new,1).replace(upload_old,upload_new,1).replace(metadata_old,metadata_new,1).replace(reader_old,reader_new,1))
+ for dest,text in files.items():dest.write_text(text)
+if __name__=='__main__':
+ p=argparse.ArgumentParser();p.add_argument('--root',required=True,type=Path);p.add_argument('--overlays',type=Path,default=Path(__file__).parent/'drive-attachments');a=p.parse_args();apply(a.root,a.overlays)
diff --git a/labs/taskflow/patches/drive-attachments/taskflow_drive.go b/labs/taskflow/patches/drive-attachments/taskflow_drive.go
new file mode 100644
index 0000000..5f09ffb
--- /dev/null
+++ b/labs/taskflow/patches/drive-attachments/taskflow_drive.go
@@ -0,0 +1,432 @@
+package storage
+
+// Private candidate. No router registration or credential setup is included.
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"log/slog"
+	"mime/multipart"
+	"net/http"
+	"net/textproto"
+	"net/url"
+	"os"
+	"path"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+const TaskFlowDriveMaxObjectBytes int64 = 100 * 1024 * 1024
+
+var ErrTaskFlowDriveReadOnly = errors.New("private Drive uploads temporarily read-only")
+
+func validTaskFlowDriveObjectKey(key string) bool {
+	if key == "" || len(key) > 1024 || strings.ContainsAny(key, "\\\x00?#%") || strings.HasPrefix(key, "/") || path.Clean(key) != key {
+		return false
+	}
+	p := strings.Split(key, "/")
+	if len(p) < 3 || (p[0] != "workspaces" && p[0] != "users") {
+		return false
+	}
+	for _, v := range p {
+		if v == "" || v == "." || v == ".." {
+			return false
+		}
+	}
+	return true
+}
+
+var ErrTaskFlowDriveUnavailable = errors.New("private Drive storage unavailable")
+var ErrTaskFlowDriveIntegrity = errors.New("original Drive file integrity mismatch; no bytes served")
+var ErrTaskFlowDriveMissing = errors.New("original Drive object missing or moved; no replacement served")
+
+// Reserve atomically inserts a binding or returns the immutable prior binding.
+// It must not change an existing key's file ID/hash/size, including after deletion.
+type TaskFlowDriveBinding struct {
+	Key, FileID, SHA256, FolderID string
+	Size                          int64
+	Ready, Deleted                bool
+}
+type TaskFlowDriveIndex interface {
+	Lookup(context.Context, string) (TaskFlowDriveBinding, error)
+	Reserve(context.Context, TaskFlowDriveBinding) (TaskFlowDriveBinding, error)
+	MarkReady(context.Context, string) error
+	MarkDeleted(context.Context, string) error
+}
+type TaskFlowDriveToken interface {
+	AccessToken(context.Context) (string, error)
+}
+type TaskFlowDriveStorage struct {
+	trashEnabled bool
+	client       *http.Client
+	tokens       TaskFlowDriveToken
+	index        TaskFlowDriveIndex
+	folder, base string
+	transfers    chan struct{}
+	readOnly     bool
+}
+
+func NewTaskFlowDriveStorage(c *http.Client, t TaskFlowDriveToken, i TaskFlowDriveIndex, folder string) (*TaskFlowDriveStorage, error) {
+	if c == nil || t == nil || i == nil || !validDriveID(folder) {
+		return nil, errors.New("incomplete private Drive configuration")
+	}
+	cc := *c
+	// Never forward credentials to a redirect supplied by a remote response.
+	cc.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	return &TaskFlowDriveStorage{client: &cc, tokens: t, index: i, folder: folder, base: "https://www.googleapis.com", transfers: make(chan struct{}, 1)}, nil
+}
+func validDriveID(v string) bool {
+	if len(v) < 1 || len(v) > 256 {
+		return false
+	}
+	for _, r := range v {
+		if !((r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') || r == '_' || r == '-') {
+			return false
+		}
+	}
+	return true
+}
+func (s *TaskFlowDriveStorage) SetReadOnly()      { s.readOnly = true }
+func (s *TaskFlowDriveStorage) CdnDomain() string { return "" }
+func (s *TaskFlowDriveStorage) ObjectURL(k string) string {
+	if !validTaskFlowDriveObjectKey(k) {
+		return ""
+	}
+	return "/uploads/" + k
+}
+func (s *TaskFlowDriveStorage) KeyFromURL(raw string) string {
+	u, e := url.Parse(raw)
+	if e != nil || u.RawQuery != "" || u.Fragment != "" || !strings.HasPrefix(u.Path, "/uploads/") {
+		return ""
+	}
+	k := strings.TrimPrefix(u.Path, "/uploads/")
+	if !validTaskFlowDriveObjectKey(k) {
+		return ""
+	}
+	return k
+}
+
+type taskFlowDrivePermit struct{}
+
+func (s *TaskFlowDriveStorage) BeginTransfer(ctx context.Context) (context.Context, func(), error) {
+	if ctx.Value(taskFlowDrivePermit{}) == s {
+		return ctx, func() {}, nil
+	}
+	if e := ctx.Err(); e != nil {
+		return ctx, func() {}, e
+	}
+	select {
+	case s.transfers <- struct{}{}:
+		var once sync.Once
+		return context.WithValue(ctx, taskFlowDrivePermit{}, s), func() { once.Do(func() { <-s.transfers }) }, nil
+	case <-ctx.Done():
+		return ctx, func() {}, ctx.Err()
+	}
+}
+func (s *TaskFlowDriveStorage) BeginUpload(ctx context.Context) (context.Context, func(), error) {
+	if s.readOnly {
+		return ctx, func() {}, ErrTaskFlowDriveReadOnly
+	}
+	return s.BeginTransfer(ctx)
+}
+func (s *TaskFlowDriveStorage) request(ctx context.Context, method, path string, body io.Reader, contentType string) (*http.Response, error) {
+	token, e := s.tokens.AccessToken(ctx)
+	if e != nil || token == "" {
+		return nil, ErrTaskFlowDriveUnavailable
+	}
+	req, e := http.NewRequestWithContext(ctx, method, s.base+path, body)
+	if e != nil {
+		return nil, ErrTaskFlowDriveUnavailable
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	if contentType != "" {
+		req.Header.Set("Content-Type", contentType)
+	}
+	response, e := s.client.Do(req)
+	if e != nil {
+		return nil, ErrTaskFlowDriveUnavailable
+	}
+	return response, nil
+}
+func closeDriveResponse(r *http.Response) {
+	io.Copy(io.Discard, io.LimitReader(r.Body, 4096))
+	r.Body.Close()
+}
+
+// Reject public/shared or foreign-owned folders rather than silently expanding
+// the task audience through inherited Drive permissions.
+func (s *TaskFlowDriveStorage) checkFolder(ctx context.Context) error {
+	r, e := s.request(ctx, http.MethodGet, "/drive/v3/files/"+s.folder+"?fields=id,mimeType,trashed,shared,ownedByMe", nil, "")
+	if e != nil {
+		return e
+	}
+	defer closeDriveResponse(r)
+	if r.StatusCode != 200 {
+		return ErrTaskFlowDriveUnavailable
+	}
+	var f struct {
+		ID      string `json:"id"`
+		Mime    string `json:"mimeType"`
+		Trashed bool   `json:"trashed"`
+		Shared  *bool  `json:"shared"`
+		Owned   bool   `json:"ownedByMe"`
+	}
+	if json.NewDecoder(io.LimitReader(r.Body, 8192)).Decode(&f) != nil || f.ID != s.folder || f.Mime != "application/vnd.google-apps.folder" || f.Trashed || f.Shared == nil || *f.Shared || !f.Owned {
+		return errors.New("Drive folder must remain private and owned by the authorized account")
+	}
+	return nil
+}
+func (s *TaskFlowDriveStorage) generateID(ctx context.Context) (string, error) {
+	r, e := s.request(ctx, http.MethodGet, "/drive/v3/files/generateIds?count=1&space=drive&type=files", nil, "")
+	if e != nil {
+		return "", e
+	}
+	defer closeDriveResponse(r)
+	var x struct {
+		IDs []string `json:"ids"`
+	}
+	if r.StatusCode != 200 || json.NewDecoder(io.LimitReader(r.Body, 8192)).Decode(&x) != nil || len(x.IDs) != 1 || !validDriveID(x.IDs[0]) {
+		return "", ErrTaskFlowDriveUnavailable
+	}
+	return x.IDs[0], nil
+}
+
+type driveObjectMeta struct {
+	Owned   bool     `json:"ownedByMe"`
+	Shared  *bool    `json:"shared"`
+	ID      string   `json:"id"`
+	Size    string   `json:"size"`
+	SHA256  string   `json:"sha256Checksum"`
+	Parents []string `json:"parents"`
+	Trashed bool     `json:"trashed"`
+}
+
+func (s *TaskFlowDriveStorage) verifyMeta(ctx context.Context, b TaskFlowDriveBinding) error {
+	r, e := s.request(ctx, http.MethodGet, "/drive/v3/files/"+b.FileID+"?fields=id,size,sha256Checksum,parents,trashed,shared,ownedByMe", nil, "")
+	if e != nil {
+		return e
+	}
+	defer closeDriveResponse(r)
+	if r.StatusCode == 404 {
+		return ErrTaskFlowDriveMissing
+	}
+	if r.StatusCode != 200 {
+		return ErrTaskFlowDriveUnavailable
+	}
+	var m driveObjectMeta
+	if json.NewDecoder(io.LimitReader(r.Body, 8192)).Decode(&m) != nil {
+		return ErrTaskFlowDriveUnavailable
+	}
+	parent := false
+	for _, p := range m.Parents {
+		if p == s.folder {
+			parent = true
+		}
+	}
+	if m.ID != b.FileID || m.Size != strconv.FormatInt(b.Size, 10) || m.Trashed || m.Shared == nil || *m.Shared || !m.Owned || !parent {
+		return ErrTaskFlowDriveMissing
+	}
+	// Some Drive objects omit SHA256; the download is still verified before serving.
+	if m.SHA256 != "" && m.SHA256 != b.SHA256 {
+		return ErrTaskFlowDriveIntegrity
+	}
+	return nil
+}
+func (s *TaskFlowDriveStorage) Upload(ctx context.Context, key string, data []byte, contentType, filename string) (string, error) {
+	ctx, release, e := s.BeginUpload(ctx)
+	if e != nil {
+		return "", e
+	}
+	defer release()
+	if !validTaskFlowDriveObjectKey(key) || len(data) > int(TaskFlowDriveMaxObjectBytes) {
+		return "", errors.New("invalid attachment key or size")
+	}
+	if e = s.checkFolder(ctx); e != nil {
+		return "", e
+	}
+	sum := sha256.Sum256(data)
+	hash := hex.EncodeToString(sum[:])
+	b, e := s.index.Lookup(ctx, key)
+	if errors.Is(e, os.ErrNotExist) {
+		id, err := s.generateID(ctx)
+		if err != nil {
+			return "", err
+		}
+		b, e = s.index.Reserve(ctx, TaskFlowDriveBinding{Key: key, FileID: id, SHA256: hash, FolderID: s.folder, Size: int64(len(data))})
+	}
+	if e != nil {
+		return "", ErrTaskFlowDriveUnavailable
+	}
+	if b.Size < 0 || b.Size > TaskFlowDriveMaxObjectBytes || b.Deleted || b.SHA256 != hash || b.Size != int64(len(data)) || b.FolderID != s.folder || !validDriveID(b.FileID) {
+		return "", errors.New("immutable attachment binding mismatch")
+	}
+	if b.Ready {
+		if e = s.verifyMeta(ctx, b); e != nil {
+			return "", e
+		}
+		r, err := s.verifiedReader(ctx, b)
+		if err != nil {
+			return "", err
+		}
+		r.Close()
+		return s.ObjectURL(key), nil
+	}
+	// Multipart data are streamed with a small metadata prefix/suffix. The file ID
+	// was durably reserved before the request so a lost response can be retried
+	// without creating a duplicate object. A conflict is never taken as proof.
+	var pre bytes.Buffer
+	mw := multipart.NewWriter(&pre)
+	h := textproto.MIMEHeader{}
+	h.Set("Content-Type", "application/json; charset=UTF-8")
+	p, _ := mw.CreatePart(h)
+	meta := map[string]any{"id": b.FileID, "name": filename, "parents": []string{s.folder}, "mimeType": contentType}
+	json.NewEncoder(p).Encode(meta)
+	h = textproto.MIMEHeader{}
+	h.Set("Content-Type", "application/octet-stream")
+	mw.CreatePart(h)
+	prefix := append([]byte(nil), pre.Bytes()...)
+	pre.Reset()
+	mw.Close()
+	suffix := append([]byte(nil), pre.Bytes()...)
+	reader := io.MultiReader(bytes.NewReader(prefix), bytes.NewReader(data), bytes.NewReader(suffix))
+	r, e := s.request(ctx, http.MethodPost, "/upload/drive/v3/files?uploadType=multipart&fields=id", reader, "multipart/related; boundary="+mw.Boundary())
+	if e != nil {
+		return "", e
+	}
+	status := r.StatusCode
+	closeDriveResponse(r)
+	if status != 200 && status != 201 && status != 409 {
+		return "", ErrTaskFlowDriveUnavailable
+	}
+	if e = s.verifyMeta(ctx, b); e != nil {
+		return "", e
+	}
+	// Verify actual bytes before acknowledging success, including409 retries.
+	verified, e := s.verifiedReader(ctx, b)
+	if e != nil {
+		return "", e
+	}
+	verified.Close()
+	if e = s.index.MarkReady(ctx, key); e != nil {
+		return "", ErrTaskFlowDriveUnavailable
+	}
+	return s.ObjectURL(key), nil
+}
+
+type taskFlowDriveReader struct {
+	*os.File
+	release func()
+	once    sync.Once
+}
+
+func (r *taskFlowDriveReader) Close() error {
+	var err error
+	r.once.Do(func() { err = r.File.Close(); os.Remove(r.File.Name()); r.release() })
+	return err
+}
+func (s *TaskFlowDriveStorage) verifiedReader(ctx context.Context, b TaskFlowDriveBinding) (io.ReadCloser, error) {
+	r, e := s.request(ctx, http.MethodGet, "/drive/v3/files/"+b.FileID+"?alt=media", nil, "")
+	if e != nil {
+		return nil, e
+	}
+	defer closeDriveResponse(r)
+	if r.StatusCode == 404 {
+		return nil, ErrTaskFlowDriveMissing
+	}
+	if r.StatusCode != 200 {
+		return nil, ErrTaskFlowDriveUnavailable
+	}
+	file, e := os.CreateTemp("", "tf-drive-read-*")
+	if e != nil {
+		return nil, e
+	}
+	fail := func(err error) (io.ReadCloser, error) { file.Close(); os.Remove(file.Name()); return nil, err }
+	hash := sha256.New()
+	n, e := io.Copy(io.MultiWriter(file, hash), io.LimitReader(r.Body, b.Size+1))
+	if e != nil {
+		return fail(ErrTaskFlowDriveUnavailable)
+	}
+	if n != b.Size || hex.EncodeToString(hash.Sum(nil)) != b.SHA256 {
+		return fail(ErrTaskFlowDriveIntegrity)
+	}
+	if _, e = file.Seek(0, io.SeekStart); e != nil {
+		return fail(e)
+	}
+	return &taskFlowDriveReader{File: file, release: func() {}}, nil
+}
+func (s *TaskFlowDriveStorage) GetReader(ctx context.Context, key string) (io.ReadCloser, error) {
+	if !validTaskFlowDriveObjectKey(key) {
+		return nil, errors.New("invalid attachment key")
+	}
+	ctx, release, e := s.BeginTransfer(ctx)
+	if e != nil {
+		return nil, e
+	}
+	if e = s.checkFolder(ctx); e != nil {
+		release()
+		return nil, e
+	}
+	b, e := s.index.Lookup(ctx, key)
+	if e != nil {
+		release()
+		if errors.Is(e, os.ErrNotExist) {
+			return nil, ErrTaskFlowDriveMissing
+		}
+		return nil, ErrTaskFlowDriveUnavailable
+	}
+	if b.Size < 0 || b.Size > TaskFlowDriveMaxObjectBytes || !b.Ready || b.Deleted || b.FolderID != s.folder || !validDriveID(b.FileID) {
+		release()
+		return nil, ErrTaskFlowDriveMissing
+	}
+	if e = s.verifyMeta(ctx, b); e != nil {
+		release()
+		return nil, e
+	}
+	r, e := s.verifiedReader(ctx, b)
+	if e != nil {
+		release()
+		return nil, e
+	}
+	r.(*taskFlowDriveReader).release = release
+	return r, nil
+}
+func (s *TaskFlowDriveStorage) DeleteObject(ctx context.Context, key string) error {
+	if !validTaskFlowDriveObjectKey(key) {
+		return errors.New("invalid attachment key")
+	}
+	return s.tryTrash(ctx, key)
+}
+
+func (s *TaskFlowDriveStorage) Delete(ctx context.Context, key string) {
+	if err := s.DeleteObject(ctx, key); err != nil {
+		slog.Warn("private Drive cleanup remains pending")
+	}
+}
+func (s *TaskFlowDriveStorage) DeleteKeys(ctx context.Context, keys []string) {
+	for _, k := range keys {
+		s.Delete(ctx, k)
+	}
+}
+
+var _ Storage = (*TaskFlowDriveStorage)(nil)
+
+func ReadTaskFlowDriveUpload(r io.Reader, size int64) ([]byte, error) {
+	if size < 0 || size > TaskFlowDriveMaxObjectBytes {
+		return nil, errors.New("invalid attachment size")
+	}
+	b := make([]byte, int(size))
+	if _, e := io.ReadFull(r, b); e != nil {
+		return nil, e
+	}
+	var extra [1]byte
+	n, e := r.Read(extra[:])
+	if n != 0 || e != io.EOF {
+		return nil, errors.New("attachment stream size mismatch")
+	}
+	return b, nil
+}
