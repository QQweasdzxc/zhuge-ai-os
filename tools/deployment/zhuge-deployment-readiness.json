{
  "contract": "zhuge-deployment-readiness-v1",
  "mode": "developer-preflight-only",
  "automatic_mutation": false,
  "production_apply": "human_gate",
  "deploy_order": [
    "preflight",
    "task-101-migration",
    "zhuge-skyeye-read",
    "task-attachment-ai-read",
    "task-094-line-protected-runtime",
    "smoke-and-readback"
  ],
  "artifacts": {
    "skyeye": {
      "kind": "supabase-edge-function",
      "function": "zhuge-skyeye-read",
      "source": "supabase/functions/zhuge-skyeye-read",
      "required_secret_names": ["TDX_CLIENT_ID", "TDX_CLIENT_SECRET", "CWA_API_KEY", "MOENV_API_KEY"],
      "non_secret_env_names": ["SKYEYE_ALLOWED_ORIGINS"],
      "smoke_contract": "zhuge-skyeye-read-v1",
      "rollback": "redeploy the previous approved function source; do not delete provider data"
    },
    "task-086": {
      "kind": "supabase-edge-function",
      "function": "task-attachment-ai-read",
      "source": "supabase/functions/task-attachment-ai-read",
      "required_secret_names": ["OPENAI_API_KEY"],
      "non_secret_env_names": ["TASK_ATTACHMENT_AI_ALLOWED_ORIGIN"],
      "smoke_contract": "zhuge-task-attachment-ai-read-v1",
      "rollback": "redeploy the previous approved function source; keep attachments and Product Data unchanged"
    },
    "task-094": {
      "kind": "supabase-edge-function",
      "function": "zhuge-line-task-runtime",
      "source": [
        "supabase/functions/zhuge-line-task-runtime/index.ts",
        "shared/line/line-task-adapter.js",
        "shared/line/line-webhook-handler.js",
        "shared/line/line-messaging-adapter.js",
        "shared/line/line-reminder-contract.js",
        "shared/line/line-runtime-contract.js",
        "docs/supabase/20260926_task_094_line_runtime.sql"
      ],
      "required_secret_names": ["LINE_CHANNEL_SECRET", "LINE_CHANNEL_ACCESS_TOKEN"],
      "status": "edge_source_ready_provider_optional",
      "smoke_contract": "zhuge-line-task-runtime-v1",
      "rollback": "redeploy the previous approved function source; keep LINE bindings and Board data unchanged"
    },
    "task-101": {
      "kind": "supabase-migration",
      "source": "docs/supabase/20260926_task_101_workflow_restore_version.sql",
      "rollback": "docs/supabase/ROLLBACK_20260926_task_101_workflow_restore_version.sql",
      "required_secret_names": [],
      "smoke_contract": "module-c-workflow-restore-version-v1"
    },
    "runtime-automation": {
      "kind": "github-actions-read-only-qa",
      "source": [
        "tools/runtime/authenticated-runtime-qa.mjs",
        "tools/runtime/provider-readiness.mjs",
        ".github/workflows/authenticated-runtime-qa.yml"
      ],
      "required_secret_names": ["Zhuge_AUTH_STORAGE_STATE_B64"],
      "status": "source_ready_credential_optional",
      "smoke_contract": "zhuge-authenticated-runtime-qa-v1",
      "rollback": "disable the workflow; no Product Data or provider state is mutated"
    }
  },
  "readback": {
    "edge": ["function_version", "contract", "sanitized_http_status", "error_code"],
    "migration": ["function_signature", "execute_grant", "search_path", "migration_record"],
    "line": ["signature_verified", "server_resolution", "idempotency_key", "mutation_boundary"],
    "secrets": "names_only"
  },
  "failure_policy": {
    "auth_or_secret_missing": "stop_before_provider_call",
    "migration_mismatch": "fail_closed_before_runtime",
    "provider_timeout": "return_unavailable_evidence_without_product_write",
    "rollback": "human_authorized_previous_checkpoint_only"
  }
}
