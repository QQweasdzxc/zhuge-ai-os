+test('disabled, lease contention, expired cursor do not create, backfill or advance',async()=>{const f=fixture();f.connection.enabled=false;assert.equal((await f.run()).status,'disabled');assert.equal(f.calls.length,0);f.connection.enabled=true;f.store.acquire=async()=>null;assert.equal((await f.run()).status,'already-running');const g=fixture();g.provider.changes=async function*(){throw Object.assign(new Error('expired'),{code:'CURSOR_EXPIRED'})};await assert.rejects(g.run(),e=>e.code==='CURSOR_EXPIRED');assert.ok(!g.calls.some(c=>Array.isArray(c)&&['import','advance'].includes(c[0])));assert.equal(g.calls.at(-1),'release');});
