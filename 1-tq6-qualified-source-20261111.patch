+ async rows(table,query){const all=[];const limited=/(^|&)limit=/.test(query);for(let offset=0;offset<=10000;offset+=500){const rows=await this.request(`${table}?${query}&user_uuid=eq.${this.userId}${limited?'':`&limit=500&offset=${offset}`}`);if(!Array.isArray(rows))throw new WorklogError('INVALID_DATA','工時資料回應不完整');if(rows.some(r=>r.user_uuid&&r.user_uuid!==this.userId))throw new WorklogError('OWNER_MISMATCH','工時帳號與目前登入帳號不符');all.push(...rows);if(limited||rows.length<500)return all;}throw new WorklogError('TOO_MANY_ROWS','工時資料超過本次可載入範圍，尚未完整載入');}
