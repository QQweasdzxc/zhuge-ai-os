+ const started=new Date(`${item.at}:00+08:00`);const payload={user_uuid:this.userId,work_date:date,started_at:started.toISOString(),ended_at:new Date(started.getTime()+Math.round(item.hours*60)*60000).toISOString(),hours:item.hours,title:item.title,note:item.note||'',event_type:rules.eventTypeCode(item.entryType||'work'),status:item.status||'completed',source:item.source||'manual',ecp_task_name_snapshot:item.ecpTask||'',legacy_id:item.id};
+ // Do not rewrite unrelated links or event codes when editing.
