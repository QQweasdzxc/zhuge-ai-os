+ }catch(error){error.saved=saved;throw error;}finally{this.busy=false;if(this.snapshot){try{await this.load(this.snapshot.year);}catch{this.snapshot=null;}}}}
+ async remove(entry){if(this.busy)throw new WorklogError('BUSY','工時正在儲存');if(!entry?.cloudId)throw new WorklogError('VALIDATION','找不到這筆原始工時');this.busy=true;try{const current=await this.freshDay(entry.date),row=current.find(x=>x.cloudId===entry.cloudId);if(!row||row.updatedAt!==entry.updatedAt)throw new WorklogError('STALE','這筆工時已在其他畫面更動，請重新載入再確認');const rows=await this.request(`work_entries?user_uuid=eq.${this.userId}&id=eq.${entry.cloudId}${entry.updatedAt?'&updated_at=eq.'+encodeURIComponent(entry.updatedAt):''}`,{method:'PATCH',headers:{Prefer:'return=representation'},body:JSON.stringify({status:'deleted',deleted_at:new Date().toISOString()})});if(!rows?.length)throw new WorklogError('STALE','這筆工時未刪除，請重新載入確認');await this.recordMetric(entry,'deleted');return rows[0];}finally{this.busy=false;if(this.snapshot){try{await this.load(this.snapshot.year);}catch{this.snapshot=null;}}}}
+ async exportMonth(month){if(!/^\d{4}-(0[1-9]|1[0-2])$/.test(month))throw new WorklogError('VALIDATION','月份不正確');if(this.busy)throw new WorklogError('BUSY','請等工時儲存完成後再匯出');await this.load(Number(month.slice(0,4)));const rules=this.rules(month+'-01');const missing=rules.workProfileMissingFields(this.snapshot.workProfile);if(missing.length)throw new WorklogError('PROFILE_REQUIRED',`尚未完成工作身分：${missing.join('、')}`);const rows=rules.workLogRowsForEcp();if(!rows.length)throw new WorklogError('EMPTY','本月份尚無工時資料可匯出');const response=await this.resourceFetch('resources/profiles/ecp-profile.json');if(!response.ok)throw new WorklogError('TEMPLATE_FAILED','ECP範本設定無法載入');const config=await response.json();await rules.exportByProfile(rows,config,month);return {count:rows.length,filename:config.filename.replace('{YYYYMM}',month.replace('-',''))};}
+}
+// Tokens are provided by a verified owner-bound connection, never read from native TF JWT.
+export function supabaseRequest({baseUrl,anonKey,getSession,expectedUserId,fetchImpl=globalThis.fetch}){
+ const origin=new URL(baseUrl);if(origin.protocol!=='https:'||origin.pathname!=='/'||origin.search||origin.hash)throw new Error('Invalid data origin');let verifiedToken='',approvedUntil=0;let accessCheck=null;
+ return async(path,options={})=>{const session=await getSession();if(!session?.access_token||session.user?.id!==expectedUserId)throw new WorklogError('CONNECTION_REQUIRED','請先連接原有工時資料');if(verifiedToken!==session.access_token){const check=await fetchImpl(new URL('/auth/v1/user',origin),{headers:{apikey:anonKey,Authorization:`Bearer ${session.access_token}`}});if(!check.ok||(await check.json()).id!==expectedUserId)throw new WorklogError('OWNER_MISMATCH','工時帳號與目前登入帳號不符');verifiedToken=session.access_token;approvedUntil=0;}
+ if(Date.now()>approvedUntil||options.method&&options.method!=='GET'){if(!accessCheck)accessCheck=(async()=>{const res=await fetchImpl(new URL('/rest/v1/rpc/resolve_app_access',origin),{method:'POST',headers:{apikey:anonKey,Authorization:`Bearer ${session.access_token}`,'Content-Type':'application/json'},body:'{}',cache:'no-store'});if(!res.ok)throw new WorklogError('ACCESS_UNVERIFIED','目前無法確認原有工時使用權');const body=await res.json(),row=Array.isArray(body)?body[0]:body;if(row?.status!=='APPROVED')throw new WorklogError('ACCESS_REQUIRED','請先完成原有工作系統的使用權確認');if(row.user_id&&row.user_id!==expectedUserId)throw new WorklogError('OWNER_MISMATCH','工時使用權帳號不符');approvedUntil=Date.now()+15000;})().finally(()=>{accessCheck=null});await accessCheck;}
+ if(!/^(work_entries|user_profiles|user_export_settings|user_work_profiles|user_work_models|user_ecp_tasks)\?/.test(path)||path.includes('#'))throw new WorklogError('INVALID_ROUTE','不支援的工時資料路徑');const res=await fetchImpl(new URL('/rest/v1/'+path,origin),{...options,headers:{...options.headers,apikey:anonKey,Authorization:`Bearer ${session.access_token}`,'Content-Type':'application/json'}});if(!res.ok)throw new WorklogError(res.status===401?'CONNECTION_REQUIRED':'SYNC_FAILED','工時資料暫時無法同步，請重試');return res.status===204?null:res.json();};
+}
