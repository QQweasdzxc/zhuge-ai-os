+const request=(value=body,headers={})=>new Request('https://auth.example/functions/v1/worklog-google-sync',{method:'POST',headers:{Origin:'https://tf.example',Authorization:'Bearer synthetic-access',...headers},body:JSON.stringify(value)});
+test('connect verifies both owner session and Google before encrypted persistence; response excludes credentials',async()=>{const f=fixture();const r=await f.handler(request());assert.equal(r.status,200);const text=await r.text();assert.ok(!text.includes('synthetic'));assert.deepEqual(f.calls.slice(0,2),['verify-session','verify-google']);assert.equal(f.calls[2].owner,'owner');});
+test('wrong origin, token/owner mismatch and disabled feature never persist',async()=>{for(const[extra,req,status]of[[{},request(body,{Origin:'https://other.example'}),403],[{},request({...body,session:{...body.session,user:{id:'other'}}}),400],[{enabled:false},request(),503]]){const f=fixture(extra);assert.equal((await f.handler(req)).status,status);assert.equal(f.calls.length,0);}});
+test('internal batch accepts only separate no-origin scheduler bearer, never browser request',async()=>{const f=fixture();assert.equal((await f.handler(request({action:'scheduled-run'}))).status,403);const response=await f.handler(new Request('https://auth.example/functions/v1/worklog-google-sync',{method:'POST',headers:{Authorization:'Bearer synthetic-scheduler'},body:JSON.stringify({action:'scheduled-run'})}));assert.equal(response.status,200);});
+test('failure contains only bounded public code, not underlying tokens or infrastructure detail',async()=>{const f=fixture({verifyGoogle:async()=>{throw new Error('synthetic-sensitive-error')}});const r=await f.handler(request());assert.equal(r.status,409);assert.ok(!(await r.text()).includes('synthetic-sensitive'));assert.equal(f.calls.length,1);});
