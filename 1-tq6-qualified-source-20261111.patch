+// Generated from canonical WorkLog sources. Do not edit this file by hand.
+// No boot, DOM, network, localStorage migration or fallback demo data is run.
+export function createWorklogRules(context={}) {
+let {entries=[],selected=new Date(),selectedMonth='',profile=null,workProfile=null,session=null,feedback={}}=context;
+const DataService={workModelsState:context.models||[],ecpTasksState:context.ecpTasks||[],queueAutoSave:()=>{}}, PriorityEngine=context.priorityEngine;
+const currentUserUuid=()=>session?.user_uuid||session?.uuid||'';
+const fetch=context.fetch||globalThis.fetch;
+const saveAll=()=>{};
+const setWorkModels=items=>{DataService.workModelsState=items;};
+// Source: modules/worklog/worklog-app.js :: worklogDescriptionLength
+function worklogDescriptionLength(value = "") {
+  return Array.from(String(value || "")).length;
+}
+
+// Source: shared/app-config.js :: WORKLOG_DESCRIPTION_MAX_LENGTH
+const WORKLOG_DESCRIPTION_MAX_LENGTH = 50;
+
+// Source: modules/worklog/worklog-app.js :: minutesFromTime
+function minutesFromTime(value = "09:00") {
+  const [h = 9, m = 0] = String(value || "09:00").slice(0, 5).split(":").map(Number);
+  return h * 60 + (m || 0);
+}
+
+// Source: modules/worklog/worklog-app.js :: entryStartMinutes
+function entryStartMinutes(entry) {
+  const time = String(entry?.at || "").slice(11, 16);
+  return minutesFromTime(time || "09:00");
+}
+
+// Source: modules/worklog/worklog-app.js :: entryEndMinutes
+function entryEndMinutes(entry) {
+  return entryStartMinutes(entry) + Math.round(Number(entry?.hours || 0) * 60);
+}
+
+// Source: modules/worklog/worklog-app.js :: worklogTimeConflicts
+function worklogTimeConflicts(item = {}) {
+  const date = String(item.date || item.at || "").slice(0, 10);
+  const start = entryStartMinutes(item);
+  const end = start + Math.max(1, Math.round(Number(item.hours || 0) * 60));
+  return entries.some(entry => {
+    if (entry.id === item.id || entry.status === "deleted" || entry.date !== date) return false;
+    const existingStart = entryStartMinutes(entry);
+    const existingEnd = entryEndMinutes(entry);
+    return start < existingEnd && end > existingStart;
+  });
+}
+
+// Source: modules/worklog/worklog-app.js :: validateEntry
+function validateEntry(item) {
+  if (!item.title) return "請輸入工作描述";
+  if (worklogDescriptionLength(item.title) > WORKLOG_DESCRIPTION_MAX_LENGTH) return `工作描述不可超過 ${WORKLOG_DESCRIPTION_MAX_LENGTH} 個字元`;
+  if (!item.at || Number.isNaN(new Date(item.at).getTime())) return "請選擇正確時間";
+  if (!item.hours || item.hours <= 0) return "請選擇工時";
+  if (item.hours > 8) return "單筆工時不可超過 8 小時";
+  const sameDayHours = entries
+    .filter(e => e.date === item.date && e.id !== item.id)
+    .reduce((s, e) => s + Number(e.hours || 0), 0);
+  if (sameDayHours + Number(item.hours) > 12) return "同日工時已超過 12 小時，請確認是否輸入錯誤";
+  if (worklogTimeConflicts(item)) return "這段時間與既有工時重疊，請調整日期或開始時間";
+  return "";
+}
+
+// Source: shared/utils/shared-utils.js :: key
+function key(d = selected) {
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
+}
+
+// Source: shared/utils/shared-utils.js :: parseWorkTimeRange
+function parseWorkTimeRange(range = "09:00~18:00") {
+  const [start = "09:00", end = "18:00"] = String(range).split("~").map(x => x.trim());
+  return { start, end };
+}
+
+// Source: modules/worklog/worklog-app.js :: profileWorkSchedule
+function profileWorkSchedule() {
+  const work = parseWorkTimeRange(profile?.workHours || "09:00~18:00");
+  const lunch = parseWorkTimeRange(profile?.lunch || "12:00~13:00");
