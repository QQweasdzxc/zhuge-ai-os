+ resolveSuggestedTime(date,hours,reserved=this.snapshot?.entries||[]){if(!this.snapshot?.profile||!Number.isFinite(hours)||hours<=0)return null;const profile=this.snapshot.profile;const minutes=t=>Number(t.split(':')[0])*60+Number(t.split(':')[1]);const [workStart,workEnd]=profile.workHours.split('~').map(minutes),[breakStart,breakEnd]=profile.lunch.split('~').map(minutes);const busy=reserved.filter(e=>e.date===date&&e.status!=='deleted').map(e=>[minutes(e.at.slice(11,16)),minutes(e.at.slice(11,16))+Math.round(e.hours*60)]);busy.push([breakStart,breakEnd]);busy.sort((a,b)=>a[0]-b[0]);let start=workStart;for(const [from,to] of busy){if(start+Math.round(hours*60)<=from)break;if(start<to)start=to;}if(start+Math.round(hours*60)>workEnd)return null;return `${date}T${String(Math.floor(start/60)).padStart(2,'0')}:${String(start%60).padStart(2,'0')}`;}
