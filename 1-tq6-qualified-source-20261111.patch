+import test from'node:test';import assert from'node:assert/strict';import{GoogleWorklogSync}from'./google-worklog-sync.mjs';
+function fixture(enabled=true){let local=null,binding=null,serial=0;const calls=[],failures=[];const worklog={snapshot:{entries:[],profile:{workHours:'09:00~18:00',lunch:'12:00~13:00'}},saveBatch:async([value])=>{calls.push(['save',value]);local={...value,cloudId:'local-row',updatedAt:'v'+(++serial)};worklog.snapshot.entries=[local];return[local]}};const store={byEvent:async()=>binding,byEntry:async()=>binding,operation:async()=>({id:'stable-google-operation'}),entry:async()=>local,eventIdentity:async()=>({id:'stable-export-operation',eventId:'stable-remote-id'}),bind:async(value)=>{binding=value},failure:async(...args)=>failures.push(args)};const provider={insert:async(calendar,event)=>{calls.push(['insert',calendar,event]);return{...event,id:'stable-remote-id',etag:'remote-v1'}},update:async(calendar,event,etag)=>{calls.push(['update',calendar,event,etag]);return{...event,etag:'remote-v2'}}};const sync=new GoogleWorklogSync({worklog,store,provider,userId:'owner',calendarId:'worklog',enabled});return{sync,worklog,store,provider,calls,failures,get local(){return local},get binding(){return binding}}}
+const remote={id:'google-new',etag:'g1',summary:'Google直接填入',start:{dateTime:'2026-11-11T12:00:00+08:00'},end:{dateTime:'2026-11-11T12:30:00+08:00'}};
+test('Google new and later edit save same local record directly without a review step',async()=>{const f=fixture();const created=await f.sync.importEvent(remote);assert.equal(created.status,'synced');assert.equal(f.local.at,'2026-11-11T12:00');assert.equal(f.binding.eventId,'google-new');const edited=await f.sync.importEvent({...remote,etag:'g2',summary:'直接修改'});assert.equal(edited.entry.cloudId,'local-row');assert.equal(f.local.title,'直接修改');assert.equal(f.worklog.snapshot.entries.length,1);assert.equal((await f.sync.importEvent({...remote,etag:'g2'})).status,'unchanged');});
+test('TF new and edit use stable event identity and bound conditional update, no private note disclosure',async()=>{const f=fixture();const entry={id:'entry',cloudId:'local-row',updatedAt:'v1',at:'2026-11-11T09:00',hours:.5,title:'TF直接填入',note:'私人備註',status:'completed'};assert.equal((await f.sync.exportEntry(entry)).status,'synced');assert.equal(f.calls[0][0],'insert');assert.equal(f.calls[0][2].id,'stable-remote-id');assert.ok(!JSON.stringify(f.calls[0]).includes(entry.note));assert.equal((await f.sync.exportEntry(entry)).status,'unchanged');await f.sync.exportEntry({...entry,updatedAt:'v2',title:'改標題'});assert.equal(f.calls[1][0],'update');assert.equal(f.calls[1][3],'remote-v1');});
+test('disabled coordinator, history, remote delete and local delete never create or cascade data',async()=>{const off=fixture(false);await assert.rejects(off.sync.importEvent(remote));assert.equal(off.calls.length,0);const f=fixture();assert.equal((await f.sync.importEvent(remote,{historical:true})).status,'skipped-history');await f.sync.importEvent(remote);const before=f.calls.length;assert.equal((await f.sync.importEvent({...remote,status:'cancelled'})).status,'remote-deleted');assert.equal((await f.sync.exportEntry({...f.local,status:'deleted'})).status,'local-deleted');assert.equal(f.calls.length,before);});
+test('provider or storage failure never reports synced or replaces old binding',async()=>{const f=fixture();f.provider.insert=async()=>{throw new Error('connection unavailable')};await assert.rejects(f.sync.exportEntry({id:'entry',cloudId:'row',updatedAt:'v1',at:'2026-11-11T09:00',hours:.5,title:'work'}),/connection unavailable/);assert.equal(f.binding,null);assert.equal(f.failures[0][2],'EXPORT_FAILED');const invalid=await assert.rejects(f.sync.importEvent({...remote,start:{date:'2026-11-11'}}));assert.equal(f.calls.length,0);assert.ok(f.failures.some(x=>x[2]==='EXACT_TIME_REQUIRED'));});
