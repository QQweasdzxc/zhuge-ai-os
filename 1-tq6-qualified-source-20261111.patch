+// Exclusively owns the NEW Supabase session minted by Calendar consent.
+// It must not receive a session still refreshed by a browser or the Office app.
+export class OwnerWorkerSession{
+ constructor({baseUrl,anonKey,owner,credentials,envelope,admin,store,fetchImpl=globalThis.fetch,now=Date.now,googleClientId,googleClientSecret}){Object.assign(this,{baseUrl,anonKey,owner,credentials,envelope,admin,store,fetch:fetchImpl,now,googleClientId,googleClientSecret});this.google=null;this.flight=null;}
+ async json(url,options){const response=await this.fetch(url,{...options,cache:'no-store',signal:AbortSignal.timeout(15000)});if(!response.ok)throw Object.assign(new Error('工時同步授權已失效，請重新連接日曆'),{code:'RECONNECT'});return response.json();}
+ async persist(){await this.admin.credential(this.owner,await this.envelope.seal(this.owner,this.credentials),this.store.lease);}
+ async getSession(){if(this.flight)return this.flight;this.flight=(async()=>{await this.store.assertLease();let session=this.credentials.session;if(!session?.refresh_token)throw new Error('Worker-owned session required');if(Number(session.expires_at)*1000-this.now()<120000){session=await this.json(new URL('/auth/v1/token?grant_type=refresh_token',this.baseUrl),{method:'POST',headers:{apikey:this.anonKey,'Content-Type':'application/json'},body:JSON.stringify({refresh_token:session.refresh_token})});if(!session.access_token||!session.refresh_token)throw new Error('Incomplete worker refresh response');session={access_token:session.access_token,refresh_token:session.refresh_token,expires_at:Number(session.expires_at)||Math.floor(this.now()/1000)+Number(session.expires_in||3600),user:{id:this.owner}};this.credentials.session=session;await this.persist();}const user=await this.json(new URL('/auth/v1/user',this.baseUrl),{headers:{apikey:this.anonKey,Authorization:'Bearer '+session.access_token}});if(user.id!==this.owner)throw new Error('Worker session owner mismatch');return{...session,user:{id:user.id}};})().finally(()=>{this.flight=null});return this.flight;}
+ async googleToken(){await this.store.assertLease();if(this.google&&this.google.expiresAt-this.now()>120000)return this.google.accessToken;if(!this.googleClientId||!this.googleClientSecret||!this.credentials.googleRefreshToken)throw Object.assign(new Error('Google持續同步授權未完成'),{code:'RECONNECT'});const data=await this.json('https://oauth2.googleapis.com/token',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({client_id:this.googleClientId,client_secret:this.googleClientSecret,grant_type:'refresh_token',refresh_token:this.credentials.googleRefreshToken}).toString()});if(!data.access_token)throw new Error('Incomplete Google token response');this.google={accessToken:data.access_token,expiresAt:this.now()+Number(data.expires_in||3600)*1000};if(data.refresh_token){this.credentials.googleRefreshToken=data.refresh_token;await this.persist();}return this.google.accessToken;}
+}
