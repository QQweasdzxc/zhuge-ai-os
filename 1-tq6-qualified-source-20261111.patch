+// Google Calendar adapter. Caller supplies short-lived access, never an API key.
+export class CalendarProviderError extends Error{constructor(code,message,status=0){super(message);this.code=code;this.status=status;}}
+export class GoogleCalendarProvider{
+ constructor({getAccessToken,fetchImpl=globalThis.fetch}){if(typeof getAccessToken!=='function')throw new Error('Owner access-token provider required');this.token=getAccessToken;this.fetch=fetchImpl;}
+ async request(path,{method='GET',body,etag,allowed=[]}={}){const token=await this.token();if(!token)throw new CalendarProviderError('RECONNECT','請重新連接 Google 工時日曆');const response=await this.fetch('https://www.googleapis.com/calendar/v3/'+path,{method,headers:{Authorization:'Bearer '+token,...(body?{'Content-Type':'application/json'}:{}),...(etag?{'If-Match':etag}:{})},...(body?{body:JSON.stringify(body)}:{}),cache:'no-store',signal:AbortSignal.timeout(15000)});if(!response.ok&&!allowed.includes(response.status))throw new CalendarProviderError(response.status===410?'CURSOR_EXPIRED':response.status===401||response.status===403?'RECONNECT':response.status===412?'REMOTE_CHANGED':'CALENDAR_FAILED',response.status===412?'日曆版本已更新，尚未覆寫原事件':'Google 工時日曆連線或儲存失敗',response.status);return{status:response.status,value:response.status===204?null:await response.json()};}
+ path(calendarId,eventId){return 'calendars/'+encodeURIComponent(calendarId)+'/events'+(eventId?'/'+encodeURIComponent(eventId):'');}
+ async calendar(calendarId){const{value}=await this.request('users/me/calendarList/'+encodeURIComponent(calendarId));if(value.id!==calendarId||!['writer','owner'].includes(value.accessRole))throw new CalendarProviderError('CALENDAR_FORBIDDEN','指定工時日曆沒有可寫入權限');return{id:value.id,name:value.summaryOverride||value.summary,timeZone:value.timeZone};}
+ async get(calendarId,eventId){return(await this.request(this.path(calendarId,eventId))).value;}
+ async insert(calendarId,event){const{status,value}=await this.request(this.path(calendarId),{method:'POST',body:event,allowed:[409]});if(status!==409)return value;const old=await this.get(calendarId,event.id),key=event.extendedProperties?.private;if(!key?.tq6_owner||!key?.tq6_entry||old.extendedProperties?.private?.tq6_owner!==key.tq6_owner||old.extendedProperties?.private?.tq6_entry!==key.tq6_entry)throw new CalendarProviderError('IDENTITY_COLLISION','日曆事件身分已存在但對應不同，沒有覆寫');if(!sameWork(old,event))throw new CalendarProviderError('REMOTE_CHANGED','這筆日曆事件已有其他修改，沒有覆寫');return old;}
+ async update(calendarId,event,etag){if(!etag)throw new CalendarProviderError('VERSION_REQUIRED','日曆版本尚未確認');const{id,extendedProperties,...patch}=event;try{return(await this.request(this.path(calendarId,id)+'?sendUpdates=none&supportsAttachments=true&conferenceDataVersion=1&eventLabelVersion=1',{method:'PATCH',body:patch,etag})).value;}catch(error){if(error.code!=='REMOTE_CHANGED')throw error;const actual=await this.get(calendarId,id);if(sameWorkFields(actual,event))return actual;throw error;}}
+ async *changes(calendarId,{syncToken}={}){let pageToken;do{const query=new URLSearchParams({maxResults:'250',showDeleted:'true'});if(syncToken)query.set('syncToken',syncToken);if(pageToken)query.set('pageToken',pageToken);const{value}=await this.request(this.path(calendarId)+'?'+query);if(!Array.isArray(value.items)||!value.nextPageToken&&!value.nextSyncToken)throw new CalendarProviderError('INCOMPLETE_PAGE','日曆同步資料不完整，游標未推進');yield{events:value.items,nextSyncToken:value.nextSyncToken||null};pageToken=value.nextPageToken;}while(pageToken);}
+}
+export function sameWorkFields(a,b){return a.status!=='cancelled'&&a.summary===b.summary&&Date.parse(a.start?.dateTime)===Date.parse(b.start?.dateTime)&&Date.parse(a.end?.dateTime)===Date.parse(b.end?.dateTime);}
+export function sameWork(a,b){const ap=a.extendedProperties?.private,bp=b.extendedProperties?.private;return a.status!=='cancelled'&&a.summary===b.summary&&Date.parse(a.start?.dateTime)===Date.parse(b.start?.dateTime)&&Date.parse(a.end?.dateTime)===Date.parse(b.end?.dateTime)&&ap?.tq6_owner===bp?.tq6_owner&&ap?.tq6_entry===bp?.tq6_entry;}
