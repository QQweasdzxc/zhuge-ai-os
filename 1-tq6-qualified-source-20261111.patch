+test('ECP rows preserve Taipei time, selected month, task snapshot and exclude notes',async()=>{const f=fixture(1);await f.service.load(2026);const rows=f.service.rules('2026-11-01').workLogRowsForEcp();assert.equal(rows[0].startAt,'2026-11-11 09:00');assert.equal(rows[0].endAt,'2026-11-11 09:30');assert.equal(rows[0].hours,.5);assert.equal(rows[0].ecpOwner,'測試人員');assert.equal(rows[0].ecpDepartment,'測試部門');assert.equal('note'in rows[0],false);assert.equal(f.service.rules('2026-10-01').workLogRowsForEcp().length,0);});
+test('owner verification rejects mismatched identity before business reads and never uses native token',async()=>{let calls=0;const request=supabaseRequest({baseUrl:'https://example.supabase.co',anonKey:'public',expectedUserId:userId,getSession:async()=>({access_token:'synthetic-session',user:{id:userId}}),fetchImpl:async()=>{calls++;return {ok:true,json:async()=>({id:'another-owner'})}}});await assert.rejects(request('work_entries?select=*'),e=>e.code==='OWNER_MISMATCH');assert.equal(calls,1);});
+
+test('fixed personal lunch cannot be moved by automatic suggestion; long defaults remain reviewable',async()=>{const f=fixture();await f.service.load(2026);assert.equal(f.service.resolveSuggestedTime('2026-11-11',4),'2026-11-11T13:00');assert.equal(f.service.resolveSuggestedTime('2026-11-11',400/60),null);assert.equal(f.service.resolveSuggestedTime('2026-11-11',.5),'2026-11-11T09:00');});
+
+test('late old-year read cannot replace newer selected-year snapshot',async()=>{const f=fixture();const original=f.service.request;let hold=true,release;const gate=new Promise(resolve=>{release=resolve});f.service.request=async(...args)=>{if(hold)await gate;return original(...args)};const old=f.service.load(2026);hold=false;await f.service.load(2027);release();await old;assert.equal(f.service.snapshot.year,2027);});
