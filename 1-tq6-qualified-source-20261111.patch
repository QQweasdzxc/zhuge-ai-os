+test('moving a saved record to another date preserves identity and original private fields',async()=>{const f=fixture(1);await f.service.load(2026);const original=f.service.snapshot.entries[0];f.tables.work_entries[0].note='保留備註';original.note='保留備註';const [saved]=await f.service.saveBatch([{...original,date:'2026-11-12',at:'2026-11-12T10:00'}],'2026-11-12');assert.equal(saved.cloudId,original.cloudId);assert.equal(saved.note,'保留備註');assert.equal(saved.date,'2026-11-12');assert.equal(f.tables.work_entries.length,1);});
