+const userId='11111111-1111-4111-8111-111111111111';
+function fixture(count=0){let serial=0;const tables={user_profiles:[{user_uuid:userId,role_code:'ADMIN',work_start_time:'09:00:00',work_end_time:'18:00:00',lunch_start_time:'12:00:00',lunch_end_time:'13:00:00'}],user_export_settings:[{user_uuid:userId,ecp_owner:'測試人員',ecp_department:'測試部門'}],user_work_profiles:[{user_uuid:userId,ecp_responsible_person:'測試人員',ecp_department:'測試部門',default_task:'測試任務',profile_completed:true}],user_ecp_tasks:[{id:'task-one',user_uuid:userId,name:'測試任務',is_active:true}],user_work_models:[{id:'model-one',user_uuid:userId,name:'範例工作A',is_active:true,default_duration_minutes:30,aliases:['合併前名稱'],source_references:[{type:'knowledge',id:'test-evidence'}],updated_at:'v1'},{id:'model-off',user_uuid:userId,name:'已停用工作',is_active:false,default_duration_minutes:400,aliases:['保留歷史']}],work_entries:[]};
+ for(let i=0;i<count;i++)tables.work_entries.push({id:'row-'+i,legacy_id:'entry-'+i,user_uuid:userId,title:'範例工作A',work_date:'2026-11-11',started_at:'2026-11-11T01:00:00Z',hours:.5,status:'completed',updated_at:'v1'});
+ const calls=[];const request=async(path,options={})=>{calls.push({path,options});const [table,query]=path.split('?'),params=new URLSearchParams(query),method=options.method||'GET';let rows=tables[table];if(!rows)throw new Error('unexpected table');let filtered=rows.filter(r=>{for(const [key,val] of params){if(['select','order','limit','offset'].includes(key))continue;if(val.startsWith('eq.')&&String(r[key]??'')!==val.slice(3))return false;if(val==='is.null'&&r[key]!=null)return false;if(val.startsWith('neq.')&&r[key]===val.slice(4))return false;if(val.startsWith('gte.')&&r[key]<val.slice(4))return false;if(val.startsWith('lt.')&&r[key]>=val.slice(3))return false;}return true});if(method==='GET'){const offset=Number(params.get('offset')||0),limit=Number(params.get('limit')||99999);return structuredClone(filtered.slice(offset,offset+limit));}const payload=JSON.parse(options.body);if(method==='POST'){const value={...payload,id:'new-'+(++serial),updated_at:'v'+(++serial)};rows.push(value);return [structuredClone(value)]}if(method==='PATCH'){for(const row of filtered)Object.assign(row,payload,{updated_at:'v'+(++serial)});return structuredClone(filtered)}throw new Error('unexpected write');};
+ const service=new WorklogService({request,userId});return {tables,calls,service};}
+const entry=(id='operation-one',at='09:00')=>({id,date:'2026-11-11',at:'2026-11-11T'+at,hours:.5,title:'範例工作A',note:'私下備註不匯出',ecpTask:'測試任務',entryType:'work',status:'completed',source:'manual'});
+test('load preserves model aliases, disabled history and actual entries, never performs migration writes',async()=>{const f=fixture(1);const s=await f.service.load(2026);assert.equal(s.entries.length,1);assert.deepEqual(s.models[0].aliases,['合併前名稱']);assert.equal(s.models[1].defaultDurationMinutes,400);assert.equal(f.service.suggestions('2026-11-11').length,1);assert.equal(f.service.suggestions('2026-11-11')[0].defaultDurationMinutes,30);assert.ok(f.calls.every(c=>!c.options.method));});
+test('reads beyond provider default page size, no silent missing year totals',async()=>{const f=fixture(1201);assert.equal((await f.service.load(2026)).entries.length,1201);});
+test('save, retry same operation and edit retain identity, notes and task links',async()=>{const f=fixture();await f.service.load(2026);const [saved]=await f.service.saveBatch([entry()],'2026-11-11');assert.ok(saved.cloudId);assert.equal(f.tables.work_entries.length,1);await f.service.saveBatch([entry()],'2026-11-11');assert.equal(f.tables.work_entries.length,1);const raw=f.tables.work_entries[0];raw.task_uuid='native-task';raw.event_type='ANNUAL_LEAVE';const next=(await f.service.load(2026)).entries[0];await f.service.saveBatch([{...next,title:'範例工作B'}],'2026-11-11');assert.equal(raw.task_uuid,'native-task');assert.equal(raw.note,'私下備註不匯出');assert.equal(raw.event_type,'ANNUAL_LEAVE');});
+test('overlap, per-entry 8h, per-day12h, invalid and wrong-date writes fail before mutation',async()=>{const f=fixture();await f.service.load(2026);await f.service.saveBatch([entry()],'2026-11-11');await assert.rejects(f.service.saveBatch([entry('two','09:15')],'2026-11-11'),/重疊/);await assert.rejects(f.service.saveBatch([{...entry('two'),hours:9}],'2026-11-11'),/8 小時/);await assert.rejects(f.service.saveBatch([{...entry('two'),hours:NaN}],'2026-11-11'));await assert.rejects(f.service.saveBatch([entry('two')],'2026-11-12'),/日期/);assert.equal(f.tables.work_entries.length,1);});
+test('source unchanged on stale edit or stale delete; ordinary sequential edit needs no conflict prompt',async()=>{const f=fixture(1);await f.service.load(2026);const old=f.service.snapshot.entries[0];f.tables.work_entries[0].updated_at='external';await assert.rejects(f.service.saveBatch([{...old,title:'錯誤覆蓋'}],old.date),/更動/);await assert.rejects(f.service.remove(old),/更動/);assert.equal(f.tables.work_entries[0].title,'範例工作A');const fresh=f.service.snapshot.entries[0];await f.service.saveBatch([{...fresh,title:'順序修改'}],fresh.date);assert.equal(f.tables.work_entries[0].title,'順序修改');});
+test('soft delete leaves other records and models unchanged, no calendar deletion',async()=>{const f=fixture(1);await f.service.load(2026);const models=structuredClone(f.tables.user_work_models);await f.service.remove(f.service.snapshot.entries[0]);assert.equal(f.tables.work_entries[0].status,'deleted');assert.deepEqual(f.tables.user_work_models[1],models[1]);assert.deepEqual(f.tables.user_work_models[0].aliases,models[0].aliases);assert.equal(f.tables.user_work_models[0].default_duration_minutes,30);assert.equal(f.tables.user_work_models[0].source_references.find(r=>r.type==='suggestion_metrics').deletedCount,1);assert.ok(f.calls.every(c=>!c.path.includes('calendar')));});
+test('partial batch reports durable successes, refreshes truth, retry does not duplicate first item',async()=>{const f=fixture();await f.service.load(2026);const a=entry(),b=entry('two','09:15');await assert.rejects(f.service.saveBatch([a,b],a.date),e=>e.saved.length===1);assert.equal(f.service.snapshot.entries.length,1);await f.service.saveBatch([a,{...b,at:'2026-11-11T09:30'}],a.date);assert.equal(f.tables.work_entries.length,2);});
