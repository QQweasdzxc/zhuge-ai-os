+// Independent Supabase session on the TF origin. Never copy the Office refresh
+// token into a second rotating client, and never treat a native TF JWT as one.
+import {WorklogError} from './worklog-service.mjs';
+const encode=bytes=>btoa(String.fromCharCode(...bytes)).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
+export class WorklogConnection {
+ constructor({supabaseUrl,anonKey,userId,storage,location,crypto=globalThis.crypto,fetchImpl=globalThis.fetch,enabled=false,calendarEnabled=false,now=Date.now}){this.base=new URL(supabaseUrl);if(this.base.protocol!=='https:'||this.base.pathname!=='/'||!anonKey||!userId)throw new Error('Invalid WorkLog auth configuration');this.anonKey=anonKey;this.userId=userId;this.storage=storage;this.location=location;this.crypto=crypto;this.fetch=fetchImpl;this.enabled=enabled;this.calendarEnabled=calendarEnabled;this.now=now;this.key='taskflow_worklog_session_v1:'+userId;this.pendingKey='taskflow_worklog_pending_v1:'+userId;this.inFlight=null;}
+ headers(){return {apikey:this.anonKey,'Content-Type':'application/json'};}
+ read(key){try{return JSON.parse(this.storage.getItem(key)||'null')}catch{return null;}}
+ disconnect(){this.storage.removeItem(this.key);this.storage.removeItem(this.pendingKey);}
+ async start(returnPath,{calendar=false}={}){if(calendar&&!this.calendarEnabled)throw new WorklogError('CALENDAR_NOT_ENABLED','Google 工時日曆同步尚未啟用，沒有更改資料');if(!this.enabled)throw new WorklogError('CONNECTION_NOT_ENABLED','工時連線尚未啟用，目前沒有更改你的登入或授權');const target=new URL(returnPath,this.location.origin);if(target.origin!==this.location.origin||!target.pathname.endsWith('/worklog')||target.hash)throw new Error('Invalid return path');const verifier=encode(this.crypto.getRandomValues(new Uint8Array(48)));const challenge=encode(new Uint8Array(await this.crypto.subtle.digest('SHA-256',new TextEncoder().encode(verifier))));this.storage.setItem(this.pendingKey,JSON.stringify({verifier,at:this.now(),returnPath:target.pathname,calendar}));const redirect=new URL('/auth/worklog',this.location.origin);const url=new URL('/auth/v1/authorize',this.base);url.search=new URLSearchParams({provider:'google',redirect_to:redirect.href,code_challenge:challenge,code_challenge_method:'S256',scopes:'openid email profile'+(calendar?' https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.calendarlist.readonly':'')}).toString();if(calendar){url.searchParams.set('access_type','offline');url.searchParams.set('prompt','consent');}this.location.assign(url.href);}
+ async verify(session,{persist=true}={}){if(!session?.access_token||!session?.refresh_token)throw new WorklogError('CONNECTION_REQUIRED','Google 登入尚未完成，請重試');const response=await this.fetch(new URL('/auth/v1/user',this.base),{headers:{...this.headers(),Authorization:'Bearer '+session.access_token},cache:'no-store'});if(!response.ok)throw new WorklogError('CONNECTION_REQUIRED','工時登入狀態無法確認，請重試');const user=await response.json();if(user.id!==this.userId)throw new WorklogError('OWNER_MISMATCH','請使用目前 TF 登入的同一個 Google 帳號；沒有切換或覆蓋資料');const clean={access_token:session.access_token,refresh_token:session.refresh_token,expires_at:Number(session.expires_at)||Math.floor(this.now()/1000)+Number(session.expires_in||3600),user:{id:user.id}};if(persist)this.storage.setItem(this.key,JSON.stringify(clean));return clean;}
