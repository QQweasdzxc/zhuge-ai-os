+test('explicit actual work crossing midnight keeps start date and exact end, no invented split or lunch confirmation',async()=>{const f=fixture();await f.service.load(2026);const value={...entry('cross-midnight','23:30'),hours:1};const[saved]=await f.service.saveBatch([value],value.date);assert.equal(saved.at,'2026-11-11T23:30');assert.equal(saved.hours,1);assert.equal(f.tables.work_entries[0].ended_at,'2026-11-11T16:30:00.000Z');assert.equal(f.tables.work_entries[0].work_date,'2026-11-11');assert.equal(f.tables.work_entries.length,1);});
