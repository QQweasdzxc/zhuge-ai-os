+import{defineConfig}from'vite';import{fileURLToPath}from'node:url';import{readFileSync}from'node:fs';export default defineConfig({plugins:[{name:'official-holiday-fixtures',configureServer(server){server.middlewares.use((req,res,next)=>{const match=req.url?.match(/^\/worklog-assets\/holidays\/(2026|2027)\.json$/);if(!match)return next();res.setHeader('Content-Type','application/json');res.end(readFileSync(fileURLToPath(new URL('../../../../modules/worklog/native/holiday-data/'+match[1]+'.json',import.meta.url))))})}}],define:{'process.env.NEXT_PUBLIC_TASKFLOW_WORKLOG_CALENDAR_ENABLED':JSON.stringify(process.env.TQ6_TEST_CALENDAR_ENABLED||'false'),'process.env.NEXT_PUBLIC_TASKFLOW_WORKLOG_ENABLED':JSON.stringify('true'),'process.env.NEXT_PUBLIC_TASKFLOW_WORKLOG_SUPABASE_URL':JSON.stringify('https://synthetic-tq6.supabase.test'),'process.env.NEXT_PUBLIC_TASKFLOW_WORKLOG_ANON_KEY':JSON.stringify('synthetic-public-key')},resolve:{alias:{'@multica/core/auth':fileURLToPath(new URL('./native-auth-fixture.ts',import.meta.url)),'@multica/core/paths':fileURLToPath(new URL('./native-path-fixture.ts',import.meta.url)),react:fileURLToPath(new URL('./node_modules/react',import.meta.url)),'react-dom':fileURLToPath(new URL('./node_modules/react-dom',import.meta.url))}},publicDir:fileURLToPath(new URL('../../../../modules/worklog',import.meta.url)),server:{host:'127.0.0.1',port:4177,fs:{allow:[fileURLToPath(new URL('../../../../',import.meta.url))]}}});
