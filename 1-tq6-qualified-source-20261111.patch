+    setU16(localView, 4, 20);
+    setU16(localView, 6, 0x0800);
+    setU16(localView, 8, 0);
+    setU32(localView, 14, crc);
+    setU32(localView, 18, data.length);
+    setU32(localView, 22, data.length);
+    setU16(localView, 26, nameBytes.length);
