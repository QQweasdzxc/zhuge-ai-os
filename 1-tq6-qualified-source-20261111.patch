--- /dev/null
+++ b/modules/worklog/native/holiday-reference.mjs
@@ -0,0 +1,19 @@
+// Official reference data only. Never infer personal attendance or create work entries.
+export const suspensionSource='https://www.dgpa.gov.tw/typh/daily/nds.html';
+const plain=value=>String(value).replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi,'').replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi,'').replace(/<br\s*\/?\s*>/gi,'\n').replace(/<[^>]*>/g,' ').replace(/&nbsp;|&#160;/gi,' ').replace(/&amp;/gi,'&').replace(/[ \t]+/g,' ').trim();
+export function parseSuspensions(html,{now=Date.now()}={}){
+ if(typeof html!=='string'||html.length>2000000)throw new Error('官方停班資料格式無法確認');
+ const stamp=plain(html).match(/更新時間[：:]\s*(\d{4})\/(\d{1,2})\/(\d{1,2})\s+(\d{1,2}):(\d{2}):(\d{2})/);
+ const table=html.match(/<table\b[^>]*id=["']?Table["']?[^>]*>([\s\S]*?)<\/table>/i);
+ if(!stamp||!table)throw new Error('官方停班資料格式無法確認');
+ const sourceUpdatedAt=`${stamp[1]}-${stamp[2].padStart(2,'0')}-${stamp[3].padStart(2,'0')}T${stamp[4].padStart(2,'0')}:${stamp[5]}:${stamp[6]}+08:00`;
+ const sourceTime=Date.parse(sourceUpdatedAt);if(!Number.isFinite(sourceTime)||sourceTime>now+300000)throw new Error('官方停班資料時間無法確認');
+ const rows=[];let noNotices=false;
+ for(const row of table[1].matchAll(/<tr\b[^>]*>([\s\S]*?)<\/tr>/gi)){
+  const cells=[...row[1].matchAll(/<td\b[^>]*>([\s\S]*?)<\/td>/gi)].map(x=>plain(x[1]));
+  if(cells.length===1&&cells[0].includes('無停班停課訊息')){noNotices=true;continue}
+  if(cells.length>=2&&cells[0]&&cells[1]&&cells[0]!=='縣市名稱')rows.push({area:cells[0],notice:cells.slice(1).join(' ')});
+ }
+ if(!rows.length&&!noNotices)throw new Error('官方停班資料尚未完整公布或格式變更');
+ return {source:suspensionSource,sourceUpdatedAt,checkedAt:new Date(now).toISOString(),stale:now-sourceTime>7200000,noNotices,rows,scope:'各地方政府公布資訊；是否適用仍依你的機關、學校或雇主規定。'};
+}
diff --git a/modules/worklog/native/holiday-reference.test.mjs b/modules/worklog/native/holiday-reference.test.mjs
new file mode 100644
index 00000000..6b3b83c4
--- /dev/null
+++ b/modules/worklog/native/holiday-reference.test.mjs
@@ -0,0 +1,7 @@
+import test from'node:test';import assert from'node:assert/strict';import{parseSuspensions}from'./holiday-reference.mjs';
+const now=Date.parse('2026-11-11T16:30:00+08:00'),wrap=(body,stamp='2026/11/11 16:11:15')=>`<div>更新時間：${stamp}</div><table id="Table"><tr><th>縣市名稱</th><th>是否停止上班上課情形</th></tr><tbody>${body}</tbody></table>`;
+test('official no-notice is a notice, never all-Taiwan workday assertion',()=>{const s=parseSuspensions(wrap('<tr><td colspan="2">無停班停課訊息。</td></tr>'),{now});assert.equal(s.noNotices,true);assert.equal(s.rows.length,0);assert.equal(s.stale,false);assert.equal(s.sourceUpdatedAt,'2026-11-11T16:11:15+08:00');});
+test('partial locality notice retained, no whole-city expansion or personal attendance writes',()=>{const s=parseSuspensions(wrap('<tr><td>測試縣市</td><td>僅山區：下午停止上班、停止上課</td></tr>'),{now});assert.deepEqual(s.rows,[{area:'測試縣市',notice:'僅山區：下午停止上班、停止上課'}]);assert.equal(s.noNotices,false);});
+test('old, missing, changed or future official data never becomes current no-notice',()=>{assert.equal(parseSuspensions(wrap('<tr><td>無停班停課訊息。</td></tr>','2026/11/10 16:11:15'),{now}).stale,true);assert.throws(()=>parseSuspensions('<table><tr><td>無資料</td></tr></table>',{now}));assert.throws(()=>parseSuspensions(wrap('<tr><td>無停班停課訊息。</td></tr>','2026/11/12 16:11:15'),{now}));});
+
+test('official yearly snapshots cover every valid date exactly once with source provenance',async()=>{for(const year of [2026,2027]){const data=JSON.parse(await(await import('node:fs/promises')).readFile(new URL('./holiday-data/'+year+'.json',import.meta.url),'utf8'));assert.equal(Object.keys(data.days).length,365);assert.equal(data.year,year);assert.equal(new URL(data.source.url).hostname,'www.dgpa.gov.tw');assert.equal(data.source.dataset,'https://data.gov.tw/dataset/14718');for(const [key,value]of Object.entries(data.days)){assert.equal(new Date(key+'T00:00:00Z').toISOString().slice(0,10),key);assert.ok(key.startsWith(year+'-'));assert.equal(typeof value.off,'boolean');}assert.equal(data.days[year+'-01-01'].label,'開國紀念日');}});
