+test('ECP export allows leave without ECP and linked work without any TF task, while retaining historical task snapshots',async()=>{const f=fixture();await f.service.load(2026);await f.service.saveBatch([{...entry(),entryType:'leave',ecpTask:'',title:'特休'}],'2026-11-11');await f.service.saveBatch([{...entry('work','10:00'),ecpTask:'歷史月份ECP項目'}],'2026-11-11');f.tables.work_entries[1].task_uuid='original-link';f.tables.work_entries[1].task_title_snapshot='原追溯';let fetched=0;f.service.resourceFetch=async()=>{fetched++;return{ok:false}};await assert.rejects(f.service.exportMonth('2026-11'),e=>e.code==='TEMPLATE_FAILED');assert.equal(fetched,1);assert.equal(f.tables.work_entries[1].task_uuid,'original-link');assert.equal(f.tables.work_entries[1].ecp_task_name_snapshot,'歷史月份ECP項目');});
