@@ -36,3 +36,7 @@ test('adjusted suggestion records edited and added on original model even after
 
 test('half-hour range saves 0.5 and 10 hours, keeps exact legacy durations and cross-month midnight export',async()=>{for(const hours of [.5,10,400/60,.75]){const f=fixture();await f.service.load(2026);const value={...entry(),date:'2026-11-30',at:'2026-11-30T23:30',hours};const [saved]=await f.service.saveBatch([value],value.date);assert.equal(saved.hours,hours);assert.equal(f.tables.work_entries[0].ended_at,new Date(Date.parse('2026-11-30T15:30:00Z')+Math.round(hours*60)*60000).toISOString());const rows=f.service.rules('2026-11-01').workLogRowsForEcp();assert.equal(rows.length,1);assert.equal(rows[0].hours,hours);assert.equal(rows[0].startAt,'2026-11-30 23:30');assert.equal(f.service.rules('2026-12-01').workLogRowsForEcp().length,0);}});
 test('new explicit leave clears ECP, existing event type is retained when title changes',async()=>{const f=fixture();await f.service.load(2026);const[saved]=await f.service.saveBatch([{...entry(),entryType:'leave',title:'特休'}],'2026-11-11');assert.equal(f.tables.work_entries[0].event_type,'LEAVE');assert.equal(f.tables.work_entries[0].ecp_task_name_snapshot,'');await f.service.saveBatch([{...saved,title:'改了標題仍是原休假'}],saved.date);assert.equal(f.tables.work_entries[0].event_type,'LEAVE');});
