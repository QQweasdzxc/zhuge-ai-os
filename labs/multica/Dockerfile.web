# Zhuge AI OS Lab wrapper for the frozen Multica web UI with a Zhuge identity handoff route.
ARG MULTICA_UPSTREAM_COMMIT=8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec

FROM alpine:3.21 AS source
ARG MULTICA_UPSTREAM_COMMIT
RUN apk add --no-cache git python3
RUN git clone https://github.com/multica-ai/multica.git /src \
 && cd /src \
 && git checkout "${MULTICA_UPSTREAM_COMMIT}"
COPY labs/multica/overrides/zhuge-handoff-page.tsx /tmp/zhuge-handoff-page.tsx
COPY labs/multica/patches/apply-zhuge-identity.py /tmp/apply-zhuge-identity.py
RUN python3 /tmp/apply-zhuge-identity.py

FROM node:22-alpine AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=source /src/pnpm-lock.yaml /src/pnpm-workspace.yaml /src/package.json /src/turbo.json /src/.npmrc ./
COPY --from=source /src/apps/web/package.json apps/web/
COPY --from=source /src/apps/web/source.config.ts apps/web/source.config.ts
COPY --from=source /src/packages/core/package.json packages/core/
COPY --from=source /src/packages/ui/package.json packages/ui/
COPY --from=source /src/packages/views/package.json packages/views/
COPY --from=source /src/packages/tsconfig/package.json packages/tsconfig/
COPY --from=source /src/packages/eslint-config/package.json packages/eslint-config/
RUN corepack enable \
 && PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" \
 && corepack prepare "$PNPM_VERSION" --activate \
 && pnpm install --frozen-lockfile

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=source /src/package.json ./
RUN corepack enable \
 && PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" \
 && corepack prepare "$PNPM_VERSION" --activate
COPY --from=deps /app ./
COPY --from=source /src/package.json /src/turbo.json /src/pnpm-workspace.yaml ./
COPY --from=source /src/apps/web/ apps/web/
COPY --from=source /src/packages/ packages/
RUN pnpm install --frozen-lockfile --offline
ARG NEXT_PUBLIC_APP_VERSION=zhuge-lab
ENV NEXT_PUBLIC_APP_VERSION=$NEXT_PUBLIC_APP_VERSION
ENV STANDALONE=true
RUN pnpm --filter @multica/web build

FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache "libcrypto3>=3.5.8-r0" "libssl3>=3.5.8-r0"
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
COPY --from=source --chown=nextjs:nodejs /src/LICENSE /src/NOTICE ./
USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]
