{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zhuge-taskflow-phase2-dispatch-runtime-v1",
  "title": "TaskFlow Phase 2 Dispatch Runtime Read Model",
  "type": "object",
  "required": [
    "schema",
    "intent_id",
    "idempotency_key",
    "workspace",
    "issue_id",
    "work_code",
    "executor_id",
    "provider",
    "status_source",
    "state",
    "authorization",
    "evidence"
  ],
  "properties": {
    "schema": {"const": "zhuge-taskflow-dispatch-persistence-v1"},
    "intent_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "issuer_user_id": {"type": "string"},
    "workspace": {"type": "string", "minLength": 1},
    "issue_id": {"type": "string", "minLength": 1},
    "work_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2,}$"},
    "executor_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "status_source": {"const": "TASKFLOW_RUNTIME_READ_MODEL"},
    "task_id": {"type": ["string", "null"]},
    "provider_run_id": {"type": ["string", "null"]},
    "provider_run_id_source": {"type": ["string", "null"], "enum": ["provider_event", "native_readback", null]},
    "state": {
      "enum": ["INTENT_CREATED", "ASSIGNED", "ACK_PENDING", "RUNNING", "OVERDUE", "BLOCKED", "CANCELLED", "FAILED", "REASSIGN_REVIEW", "REVIEW", "DONE", "UNKNOWN", "PM_ACCEPTED"]
    },
    "authorization": {"enum": ["AUTHORIZED", "DENIED", "UNVERIFIED"]},
    "writer_id": {"type": ["string", "null"]},
    "fencing_epoch": {"type": "integer", "minimum": 0},
    "lease_active": {"type": "boolean"},
    "lease_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "checkpoint_ref": {"type": ["string", "null"]},
    "last_heartbeat_at": {"type": ["string", "null"], "format": "date-time"},
    "quota_state": {"enum": ["UNKNOWN", "EXHAUSTED"]},
    "version": {"type": "integer", "minimum": 1},
    "evidence": {
      "type": "object",
      "required": ["provider_ack", "provider_run_id_source", "github_sha_source"],
      "properties": {
        "provider_ack": {"enum": ["VERIFIED", "UNVERIFIED", "NOT_AVAILABLE"]},
        "provider_run_id_source": {"enum": ["provider_event", "native_readback", "UNVERIFIED", "NOT_AVAILABLE"]},
        "github_sha_source": {"enum": ["native_github_mirror", "manual_record_pending_native_readback", "NOT_AVAILABLE"]},
        "blocked_reason": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]}
      }
    }
  }
}
