# TaskFlow-owned web wrapper. Build with the Zhuge repository root as context.
# Multica source is copied from the immutable local vendor snapshot; no source clone.
ARG MULTICA_SOURCE_SHA=8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec

FROM alpine:3.21 AS source
ARG MULTICA_SOURCE_SHA
RUN apk add --no-cache python3
WORKDIR /
COPY third_party/multica/ /src/
RUN test "${MULTICA_SOURCE_SHA}" = "8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec" \
 && test -f /src/LICENSE \
 && test -f /src/NOTICE \
 && echo "TASKFLOW_SOURCE_MODE=vendored SHA=${MULTICA_SOURCE_SHA}; upstream application source clone=disabled"

COPY labs/taskflow/overrides/zhuge-handoff.html /tmp/zhuge-handoff.html
COPY labs/taskflow/overrides/zhuge-ready-route.ts /tmp/zhuge-ready-route.ts
COPY labs/taskflow/overrides/zhuge-root-page.tsx /tmp/zhuge-root-page.tsx
COPY labs/taskflow/overrides/zhuge-login-page.tsx /tmp/zhuge-login-page.tsx
COPY labs/taskflow/overrides/zhuge-cli-proxy.ts /tmp/zhuge-cli-proxy.ts
COPY labs/taskflow/cli-sso.js /tmp/zhuge-cli-sso.js
COPY labs/taskflow/overrides/zhuge_auth_cli_test.go /tmp/zhuge_auth_cli_test.go
COPY labs/taskflow/overrides/zhuge_cli_grant.go /tmp/zhuge_cli_grant.go
COPY labs/taskflow/overrides/zhuge_cli_grant_test.go /tmp/zhuge_cli_grant_test.go
COPY labs/taskflow/overrides/zhuge_cli_middleware_test.go /tmp/zhuge_cli_middleware_test.go
COPY labs/taskflow/overrides/zhuge-help-launcher.tsx /tmp/zhuge-help-launcher.tsx
COPY labs/taskflow/overrides/multica-brand-mark.tsx /tmp/multica-brand-mark.tsx
COPY labs/taskflow/patches/apply-zhuge-identity.py /tmp/apply-zhuge-identity.py
COPY labs/taskflow/patches/apply-zhuge-house-rules.py /tmp/apply-zhuge-house-rules.py
RUN python3 /tmp/apply-zhuge-identity.py \
 && python3 /tmp/apply-zhuge-house-rules.py

COPY labs/taskflow/patches/apply-taskflow-project-navigation.py /tmp/apply-taskflow-project-navigation.py
COPY labs/taskflow/tests/test_taskflow_project_navigation_overlay.py /tmp/test_taskflow_project_navigation_overlay.py
RUN TASKFLOW_PROJECT_NAV_SOURCE=/src \
    TASKFLOW_PROJECT_NAV_PATCH=/tmp/apply-taskflow-project-navigation.py \
    python3 /tmp/test_taskflow_project_navigation_overlay.py \
 && python3 /tmp/apply-taskflow-project-navigation.py --root /src

COPY labs/taskflow/patches/apply-taskflow-stability.py /tmp/apply-taskflow-stability.py
COPY labs/taskflow/tests/test_taskflow_stability_overlay.py /tmp/test_taskflow_stability_overlay.py
COPY labs/taskflow/overrides/taskflow-row-query.test.ts /taskflow-stability-overlays/taskflow-row-query.test.ts
COPY labs/taskflow/overrides/taskflow-list-load-more-footer.test.tsx /taskflow-stability-overlays/taskflow-list-load-more-footer.test.tsx
COPY labs/taskflow/overrides/taskflow-pagination-recovery.test.tsx /taskflow-stability-overlays/taskflow-pagination-recovery.test.tsx
RUN TASKFLOW_STABILITY_PATCH_SCRIPT=/tmp/apply-taskflow-stability.py \
    TASKFLOW_STABILITY_REPO_ROOT=/src \
    TASKFLOW_STABILITY_TARGET=web \
    TASKFLOW_VENDOR_SOURCE_ROOT=/src TASKFLOW_STABILITY_OVERLAY_ROOT=/taskflow-stability-overlays \
    python3 /tmp/test_taskflow_stability_overlay.py \
 && python3 /tmp/apply-taskflow-stability.py --target web --root /src --overlays /taskflow-stability-overlays

COPY labs/taskflow/patches/apply-taskflow-zh-hant.py /tmp/apply-taskflow-zh-hant.py
COPY labs/taskflow/tests/test_taskflow_zh_hant_overlay.py /tmp/test_taskflow_zh_hant_overlay.py
COPY labs/taskflow/overrides/locales/zh-Hant/ /taskflow-zh-hant/locales/zh-Hant/
COPY labs/taskflow/overrides/workspace-names-zh-Hant.json /taskflow-zh-hant/workspace-names-zh-Hant.json
COPY labs/taskflow/overrides/taskflow_zh_hant_language_test.go /taskflow-zh-hant/taskflow_zh_hant_language_test.go
RUN TASKFLOW_ZH_HANT_ROOT=/src \
    TASKFLOW_ZH_HANT_OVERLAY_ROOT=/taskflow-zh-hant \
    TASKFLOW_ZH_HANT_PATCH_SCRIPT=/tmp/apply-taskflow-zh-hant.py \
    python3 /tmp/test_taskflow_zh_hant_overlay.py \
 && python3 /tmp/apply-taskflow-zh-hant.py --target web --root /src --overlays /taskflow-zh-hant

COPY labs/taskflow/patches/apply-taskflow-apps-navigation.py /tmp/apply-taskflow-apps-navigation.py
COPY labs/taskflow/tests/test_taskflow_apps_navigation_overlay.py /tmp/test_taskflow_apps_navigation_overlay.py
COPY labs/taskflow/overrides/locales/zh-Hant/layout.json /tmp/taskflow-apps-zh-Hant-layout.json
RUN TASKFLOW_APPS_REPO=/ \
    TASKFLOW_APPS_VENDOR=/src \
    TASKFLOW_APPS_PATCH=/tmp/apply-taskflow-apps-navigation.py \
    TASKFLOW_APPS_HANT_LAYOUT=/tmp/taskflow-apps-zh-Hant-layout.json \
    python3 /tmp/test_taskflow_apps_navigation_overlay.py \
 && python3 /tmp/apply-taskflow-apps-navigation.py --root /src

COPY labs/taskflow/patches/apply-taskflow-project-status.py /tmp/apply-taskflow-project-status.py
COPY labs/taskflow/tests/test_taskflow_project_status_overlay.py /tmp/test_taskflow_project_status_overlay.py
COPY labs/taskflow/overrides/taskflow-project-status-scope.tsx /taskflow-project-status/taskflow-project-status-scope.tsx
COPY labs/taskflow/overrides/taskflow-project-status-scope.test.ts /taskflow-project-status/taskflow-project-status-scope.test.ts
COPY labs/taskflow/overrides/taskflow-project-status-preferences.test.tsx /taskflow-project-status/taskflow-project-status-preferences.test.tsx
COPY labs/taskflow/overrides/taskflow-project-status-settings.tsx /taskflow-project-status/taskflow-project-status-settings.tsx
COPY labs/taskflow/overrides/taskflow-project-status-settings.test.tsx /taskflow-project-status/taskflow-project-status-settings.test.tsx
COPY labs/taskflow/overrides/taskflow-project-status-locales.json /taskflow-project-status/taskflow-project-status-locales.json
RUN TASKFLOW_PROJECT_STATUS_REPO_ROOT=/ \
    TASKFLOW_PROJECT_STATUS_VENDOR_ROOT=/src \
    TASKFLOW_PROJECT_STATUS_PATCH=/tmp/apply-taskflow-project-status.py \
    TASKFLOW_PROJECT_STATUS_OVERLAY_ROOT=/taskflow-project-status \
    python3 /tmp/test_taskflow_project_status_overlay.py \
 && python3 /tmp/apply-taskflow-project-status.py --root /src --overlays /taskflow-project-status

COPY labs/taskflow/patches/apply-taskflow-attachment-preview.py /tmp/apply-taskflow-attachment-preview.py
COPY labs/taskflow/tests/test_taskflow_attachment_preview_overlay.py /tmp/test_taskflow_attachment_preview_overlay.py
RUN TASKFLOW_ATTACHMENT_REPO=/ \
    TASKFLOW_ATTACHMENT_VENDOR=/src \
    TASKFLOW_ATTACHMENT_PATCH=/tmp/apply-taskflow-attachment-preview.py \
    python3 /tmp/test_taskflow_attachment_preview_overlay.py \
 && python3 /tmp/apply-taskflow-attachment-preview.py --root /src

# TaskFlow AI execution v1: native visible, fail-closed panel on copied source.
# No provider credentials, migrations, native Run writes, or external AI calls.
COPY labs/taskflow/patches/apply-taskflow-ai-engineering.py /tmp/apply-taskflow-ai-engineering.py
COPY labs/taskflow/tests/test_taskflow_ai_engineering_overlay.py /tmp/test_taskflow_ai_engineering_overlay.py
COPY labs/taskflow/overrides/taskflow-ai-engineering-policy.ts /taskflow-ai/taskflow-ai-engineering-policy.ts
COPY labs/taskflow/overrides/taskflow-ai-preview-store.ts /taskflow-ai/taskflow-ai-preview-store.ts
COPY labs/taskflow/overrides/taskflow-ai-engineering.tsx /taskflow-ai/taskflow-ai-engineering.tsx
COPY labs/taskflow/overrides/taskflow-ai-engineering-policy.test.ts /taskflow-ai/taskflow-ai-engineering-policy.test.ts
RUN TASKFLOW_AI_REPO=/src TASKFLOW_AI_VENDOR=/src TASKFLOW_AI_OVERLAYS=/taskflow-ai TASKFLOW_AI_PATCH=/tmp/apply-taskflow-ai-engineering.py \
    python3 /tmp/test_taskflow_ai_engineering_overlay.py \
 && python3 /tmp/apply-taskflow-ai-engineering.py --root /src --overlays /taskflow-ai

COPY labs/taskflow/patches/apply-taskflow-dispatch-center.py /tmp/apply-taskflow-dispatch-center.py
COPY labs/taskflow/overrides/taskflow-dispatch-center.tsx /taskflow-dispatch/taskflow-dispatch-center.tsx
COPY labs/taskflow/overrides/taskflow-dispatch-center.test.tsx /taskflow-dispatch/taskflow-dispatch-center.test.tsx
COPY labs/taskflow/overrides/taskflow-dispatch-logic.d.mts /taskflow-dispatch/taskflow-dispatch-logic.d.mts
COPY labs/taskflow/pages-client/dispatch-workbench.mjs /taskflow-dispatch/dispatch-workbench.mjs
RUN python3 /tmp/apply-taskflow-dispatch-center.py --root /src --overlays /taskflow-dispatch --logic /taskflow-dispatch/dispatch-workbench.mjs

FROM node:22-alpine AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_ENABLE_CLOUD_RUNTIME=false
COPY --from=source /src/pnpm-lock.yaml /src/pnpm-workspace.yaml /src/package.json /src/turbo.json /src/.npmrc ./
COPY --from=source /src/apps/web/package.json apps/web/
COPY --from=source /src/apps/web/source.config.ts apps/web/source.config.ts
COPY --from=source /src/packages/core/package.json packages/core/
COPY --from=source /src/packages/ui/package.json packages/ui/
COPY --from=source /src/packages/views/package.json packages/views/
COPY --from=source /src/packages/tsconfig/package.json packages/tsconfig/
COPY --from=source /src/packages/eslint-config/package.json packages/eslint-config/
RUN corepack enable \
 && PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" \
 && corepack prepare "$PNPM_VERSION" --activate \
 && pnpm install --frozen-lockfile

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_ENABLE_CLOUD_RUNTIME=false
COPY --from=source /src/package.json ./
RUN corepack enable \
 && PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" \
 && corepack prepare "$PNPM_VERSION" --activate
COPY --from=deps /app ./
COPY --from=source /src/package.json /src/turbo.json /src/pnpm-workspace.yaml ./
COPY --from=source /src/apps/web/ apps/web/
COPY --from=source /src/packages/ packages/
RUN pnpm install --frozen-lockfile --offline
COPY labs/taskflow/overrides/taskflow-attachment-preview-token-auth.test.tsx /tmp/taskflow-attachment-preview-token-auth.test.tsx
RUN cp /tmp/taskflow-attachment-preview-token-auth.test.tsx /app/packages/views/editor/taskflow-attachment-preview-token-auth.test.tsx \
 && pnpm --filter @multica/views exec vitest run editor/taskflow-attachment-preview-token-auth.test.tsx
RUN pnpm --filter @multica/core exec vitest run issues/taskflow-row-query.test.ts \
 && pnpm --filter @multica/core exec vitest run i18n/pick-locale.test.ts i18n/user-locale-sync.test.tsx i18n/taskflow-locale.test.ts i18n/taskflow-locale-browser.test.ts i18n/taskflow-locale-sync.test.tsx \
 && pnpm --filter @multica/views exec vitest run issues/components/taskflow-list-load-more-footer.test.tsx \
 && pnpm --filter @multica/views exec vitest run layout/app-sidebar.test.tsx \
 && pnpm --filter @multica/views exec vitest run settings/components/preferences-tab.test.tsx locales/mcp.test.ts agents/components/tabs/task-failure.test.ts onboarding/templates/index.test.ts workspace/slug.test.ts common/docs-locale.test.ts runtimes/components/runtime-docs.test.ts \
 && pnpm --filter @multica/views exec vitest run issues/surface/taskflow-pagination-recovery.test.tsx \
 && pnpm --filter @multica/views exec vitest run issues/surface/use-issue-status-branches.test.tsx issues/surface/use-issue-group-branches.test.tsx
RUN pnpm --filter @multica/core exec vitest run issue-statuses/taskflow-project-status-scope.test.ts issue-statuses/taskflow-project-status-preferences.test.tsx \
 && pnpm --filter @multica/views exec vitest run issues/components/taskflow-project-status-settings.test.tsx
RUN pnpm --filter @multica/views exec vitest run common/taskflow-dispatch-center.test.tsx
RUN pnpm --filter @multica/web exec vitest run lib/locale-routing.test.ts lib/taskflow-locale-routing.test.ts lib/docs-href.test.ts app/global-error.test.tsx features/landing/i18n/dictionary.test.ts features/landing/components/inline-links.test.ts features/landing/components/changelog-page-client.test.ts lib/use-case-locale-fallback.test.ts lib/taskflow-html-lang.test.ts
ARG NEXT_PUBLIC_APP_VERSION=taskflow-parity
ENV NEXT_PUBLIC_APP_VERSION=${NEXT_PUBLIC_APP_VERSION} \
    STANDALONE=true
RUN pnpm --filter @multica/web build

FROM node:22-alpine AS runtime
WORKDIR /app
RUN apk add --no-cache "libcrypto3>=3.5.8-r0" "libssl3>=3.5.8-r0"
ENV NODE_ENV=production \
    REMOTE_API_URL=http://backend:8080 \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_ENABLE_CLOUD_RUNTIME=false
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=source --chown=nextjs:nodejs /src/apps/web/public ./apps/web/public
COPY --from=source --chown=nextjs:nodejs /src/LICENSE /src/NOTICE ./
LABEL org.opencontainers.image.title="TaskFlow · Multica web" \
      org.opencontainers.image.vendor="Index Labs (Hong Kong) Limited" \
      org.opencontainers.image.source="https://github.com/multica-ai/multica" \
      org.opencontainers.image.revision="8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec"
USER nextjs
EXPOSE 3000
ENV PORT=3000 \
    HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]
