# TaskFlow-owned web wrapper. Build with the Zhuge repository root as context.
# Multica source is copied from the immutable local vendor snapshot; no source clone.
ARG MULTICA_SOURCE_SHA=8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec

FROM alpine:3.21 AS source
ARG MULTICA_SOURCE_SHA
RUN apk add --no-cache python3
WORKDIR /
COPY third_party/multica/ /src/
RUN test "${MULTICA_SOURCE_SHA}" = "8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec" \
 && test -f /src/LICENSE \
 && test -f /src/NOTICE \
 && echo "TASKFLOW_SOURCE_MODE=vendored SHA=${MULTICA_SOURCE_SHA}; upstream application source clone=disabled"

COPY labs/taskflow/overrides/zhuge-handoff-page.tsx /tmp/zhuge-handoff-page.tsx
COPY labs/taskflow/overrides/zhuge-ready-route.ts /tmp/zhuge-ready-route.ts
COPY labs/taskflow/overrides/zhuge-root-page.tsx /tmp/zhuge-root-page.tsx
COPY labs/taskflow/overrides/zhuge-login-page.tsx /tmp/zhuge-login-page.tsx
COPY labs/taskflow/overrides/zhuge-help-launcher.tsx /tmp/zhuge-help-launcher.tsx
COPY labs/taskflow/patches/apply-zhuge-identity.py /tmp/apply-zhuge-identity.py
COPY labs/taskflow/patches/apply-zhuge-house-rules.py /tmp/apply-zhuge-house-rules.py
RUN python3 /tmp/apply-zhuge-identity.py \
 && python3 /tmp/apply-zhuge-house-rules.py

FROM node:22-alpine AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_ENABLE_CLOUD_RUNTIME=false
COPY --from=source /src/pnpm-lock.yaml /src/pnpm-workspace.yaml /src/package.json /src/turbo.json /src/.npmrc ./
COPY --from=source /src/apps/web/package.json apps/web/
COPY --from=source /src/apps/web/source.config.ts apps/web/source.config.ts
COPY --from=source /src/packages/core/package.json packages/core/
COPY --from=source /src/packages/ui/package.json packages/ui/
COPY --from=source /src/packages/views/package.json packages/views/
COPY --from=source /src/packages/tsconfig/package.json packages/tsconfig/
COPY --from=source /src/packages/eslint-config/package.json packages/eslint-config/
RUN corepack enable \
 && PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" \
 && corepack prepare "$PNPM_VERSION" --activate \
 && pnpm install --frozen-lockfile

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_ENABLE_CLOUD_RUNTIME=false
COPY --from=source /src/package.json ./
RUN corepack enable \
 && PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" \
 && corepack prepare "$PNPM_VERSION" --activate
COPY --from=deps /app ./
COPY --from=source /src/package.json /src/turbo.json /src/pnpm-workspace.yaml ./
COPY --from=source /src/apps/web/ apps/web/
COPY --from=source /src/packages/ packages/
RUN pnpm install --frozen-lockfile --offline
ARG NEXT_PUBLIC_APP_VERSION=taskflow-parity
ENV NEXT_PUBLIC_APP_VERSION=${NEXT_PUBLIC_APP_VERSION} \
    STANDALONE=true
RUN pnpm --filter @multica/web build

FROM node:22-alpine AS runtime
WORKDIR /app
RUN apk add --no-cache "libcrypto3>=3.5.8-r0" "libssl3>=3.5.8-r0"
ENV NODE_ENV=production \
    REMOTE_API_URL=http://backend:8080 \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_ENABLE_CLOUD_RUNTIME=false
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=source --chown=nextjs:nodejs /src/apps/web/public ./apps/web/public
COPY --from=source --chown=nextjs:nodejs /src/LICENSE /src/NOTICE ./
LABEL org.opencontainers.image.title="TaskFlow · Multica web" \
      org.opencontainers.image.vendor="Index Labs (Hong Kong) Limited" \
      org.opencontainers.image.source="https://github.com/multica-ai/multica" \
      org.opencontainers.image.revision="8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec"
USER nextjs
EXPOSE 3000
ENV PORT=3000 \
    HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]
