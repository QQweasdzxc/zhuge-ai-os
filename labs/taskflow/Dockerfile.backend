# TaskFlow-owned backend wrapper. Build with the Zhuge repository root as context.
# Multica source is copied from the immutable local vendor snapshot; no source clone.
ARG MULTICA_SOURCE_SHA=8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec

FROM alpine:3.21 AS source
ARG MULTICA_SOURCE_SHA
RUN apk add --no-cache python3
WORKDIR /
COPY third_party/multica/ /src/
RUN test "${MULTICA_SOURCE_SHA}" = "8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec" \
 && test -f /src/LICENSE \
 && test -f /src/NOTICE \
 && echo "TASKFLOW_SOURCE_MODE=vendored SHA=${MULTICA_SOURCE_SHA}; upstream application source clone=disabled"

COPY labs/taskflow/overrides/dbid.go /tmp/dbid.go
COPY labs/taskflow/overrides/zhuge_auth.go /tmp/zhuge_auth.go
COPY labs/taskflow/overrides/zhuge-cli-proxy.ts /tmp/zhuge-cli-proxy.ts
COPY labs/taskflow/overrides/zhuge_auth_cli_test.go /tmp/zhuge_auth_cli_test.go
COPY labs/taskflow/overrides/zhuge_cli_grant.go /tmp/zhuge_cli_grant.go
COPY labs/taskflow/overrides/zhuge_cli_grant_test.go /tmp/zhuge_cli_grant_test.go
COPY labs/taskflow/overrides/zhuge_cli_middleware_test.go /tmp/zhuge_cli_middleware_test.go
COPY labs/taskflow/patches/patch-cli-auth-middleware.py /tmp/patch-cli-auth-middleware.py
COPY labs/taskflow/cli-sso.js /tmp/zhuge-cli-sso.js
COPY labs/taskflow/overrides/zhuge-handoff.html /tmp/zhuge-handoff.html
COPY labs/taskflow/overrides/zhuge-root-page.tsx /tmp/zhuge-root-page.tsx
COPY labs/taskflow/overrides/zhuge-login-page.tsx /tmp/zhuge-login-page.tsx
COPY labs/taskflow/overrides/zhuge-help-launcher.tsx /tmp/zhuge-help-launcher.tsx
COPY labs/taskflow/overrides/multica-brand-mark.tsx /tmp/multica-brand-mark.tsx
COPY labs/taskflow/patches/apply-zhuge-identity.py /tmp/apply-zhuge-identity.py
COPY labs/taskflow/patches/apply-zhuge-house-rules.py /tmp/apply-zhuge-house-rules.py
COPY labs/taskflow/patches/patch-router-contract-test-main.py /tmp/patch-router-contract-test-main.py
COPY labs/taskflow/patches/apply-taskflow-db-boundary.py /tmp/apply-taskflow-db-boundary.py
COPY labs/taskflow/patches/stage-migrations.py /tmp/stage-migrations.py
RUN cp /tmp/dbid.go /src/server/pkg/dbid/dbid.go \
 && cp /tmp/zhuge_auth.go /src/server/internal/handler/zhuge_auth.go \
 && python3 /tmp/apply-taskflow-db-boundary.py \
 && python3 /tmp/apply-zhuge-identity.py \
 && python3 /tmp/patch-cli-auth-middleware.py \
 && python3 /tmp/apply-zhuge-house-rules.py \
 && python3 /tmp/stage-migrations.py \
      --source /src/server/migrations \
      --output /taskflow-staged-migrations \
 && python3 /tmp/patch-router-contract-test-main.py

# TaskFlow-owned native Run approval/readback and gated GitHub @codex handoff.
# Runtime gates default off; this build does not send a Codex request or apply
# migrations. Production configuration remains unchanged by the image build.
COPY labs/taskflow/overrides/zhuge_ai_dispatch.go /taskflow-ai-dispatch/zhuge_ai_dispatch.go
COPY labs/taskflow/overrides/zhuge_ai_codex.go /taskflow-ai-dispatch/zhuge_ai_codex.go
COPY labs/taskflow/overrides/zhuge_codex_webhook.go /taskflow-ai-dispatch/zhuge_codex_webhook.go
COPY labs/taskflow/overrides/zhuge_github_webhook.go /taskflow-ai-dispatch/zhuge_github_webhook.go
COPY labs/taskflow/overrides/zhuge_ai_contract.go /taskflow-ai-dispatch/zhuge_ai_contract.go
COPY labs/taskflow/overrides/zhuge_ai_contract_test.go /taskflow-ai-dispatch/zhuge_ai_contract_test.go
COPY labs/taskflow/overrides/zhuge_ai_codex_test.go /taskflow-ai-dispatch/zhuge_ai_codex_test.go
COPY labs/taskflow/overrides/zhuge_codex_webhook_test.go /taskflow-ai-dispatch/zhuge_codex_webhook_test.go
COPY labs/taskflow/overrides/migrations/591_zhuge_ai_engineering_run.up.sql /taskflow-ai-dispatch/migrations/591_zhuge_ai_engineering_run.up.sql
COPY labs/taskflow/overrides/migrations/591_zhuge_ai_engineering_run.down.sql /taskflow-ai-dispatch/migrations/591_zhuge_ai_engineering_run.down.sql
COPY labs/taskflow/overrides/migrations/592_zhuge_ai_run_active_issue_index.up.sql /taskflow-ai-dispatch/migrations/592_zhuge_ai_run_active_issue_index.up.sql
COPY labs/taskflow/overrides/migrations/592_zhuge_ai_run_active_issue_index.down.sql /taskflow-ai-dispatch/migrations/592_zhuge_ai_run_active_issue_index.down.sql
COPY labs/taskflow/overrides/migrations/593_zhuge_ai_run_idempotency_index.up.sql /taskflow-ai-dispatch/migrations/593_zhuge_ai_run_idempotency_index.up.sql
COPY labs/taskflow/overrides/migrations/593_zhuge_ai_run_idempotency_index.down.sql /taskflow-ai-dispatch/migrations/593_zhuge_ai_run_idempotency_index.down.sql
COPY labs/taskflow/overrides/migrations/594_zhuge_ai_event_delivery_once_index.up.sql /taskflow-ai-dispatch/migrations/594_zhuge_ai_event_delivery_once_index.up.sql
COPY labs/taskflow/overrides/migrations/594_zhuge_ai_event_delivery_once_index.down.sql /taskflow-ai-dispatch/migrations/594_zhuge_ai_event_delivery_once_index.down.sql
COPY labs/taskflow/overrides/migrations/595_zhuge_ai_run_issue_history_index.up.sql /taskflow-ai-dispatch/migrations/595_zhuge_ai_run_issue_history_index.up.sql
COPY labs/taskflow/overrides/migrations/595_zhuge_ai_run_issue_history_index.down.sql /taskflow-ai-dispatch/migrations/595_zhuge_ai_run_issue_history_index.down.sql
COPY labs/taskflow/overrides/migrations/596_zhuge_ai_event_run_index.up.sql /taskflow-ai-dispatch/migrations/596_zhuge_ai_event_run_index.up.sql
COPY labs/taskflow/overrides/migrations/596_zhuge_ai_event_run_index.down.sql /taskflow-ai-dispatch/migrations/596_zhuge_ai_event_run_index.down.sql
COPY labs/taskflow/overrides/migrations/597_zhuge_ai_settings.up.sql /taskflow-ai-dispatch/migrations/597_zhuge_ai_settings.up.sql
COPY labs/taskflow/overrides/migrations/597_zhuge_ai_settings.down.sql /taskflow-ai-dispatch/migrations/597_zhuge_ai_settings.down.sql
COPY labs/taskflow/overrides/migrations/598_zhuge_ai_codex_dispatch.up.sql /taskflow-ai-dispatch/migrations/598_zhuge_ai_codex_dispatch.up.sql
COPY labs/taskflow/overrides/migrations/598_zhuge_ai_codex_dispatch.down.sql /taskflow-ai-dispatch/migrations/598_zhuge_ai_codex_dispatch.down.sql
COPY labs/taskflow/patches/apply-taskflow-ai-dispatch.py /tmp/apply-taskflow-ai-dispatch.py
COPY labs/taskflow/tests/test_zhuge_ai_native_dispatch_overlay.py /tmp/test_zhuge_ai_native_dispatch_overlay.py
RUN TASKFLOW_AI_DISPATCH_REPO=/ \
    TASKFLOW_AI_DISPATCH_VENDOR=/src \
    TASKFLOW_AI_DISPATCH_OVERLAYS=/taskflow-ai-dispatch \
    TASKFLOW_AI_DISPATCH_MIGRATIONS=/taskflow-ai-dispatch/migrations \
    TASKFLOW_AI_DISPATCH_PATCH=/tmp/apply-taskflow-ai-dispatch.py \
    python3 /tmp/test_zhuge_ai_native_dispatch_overlay.py \
 && python3 /tmp/apply-taskflow-ai-dispatch.py --root /src \
      --overlays /taskflow-ai-dispatch --migrations /taskflow-staged-migrations

# Test the router after every TaskFlow and house-rule patch has been applied.
COPY labs/taskflow/overrides/taskflow_router_contract_test.go /src/server/cmd/server/taskflow_router_contract_test.go

COPY labs/taskflow/patches/apply-taskflow-stability.py /tmp/apply-taskflow-stability.py
COPY labs/taskflow/tests/test_taskflow_stability_overlay.py /tmp/test_taskflow_stability_overlay.py
COPY labs/taskflow/overrides/taskflow_pool_budget.go /taskflow-stability-overlays/taskflow_pool_budget.go
COPY labs/taskflow/overrides/taskflow_pool_budget_test.go /taskflow-stability-overlays/taskflow_pool_budget_test.go
COPY labs/taskflow/overrides/taskflow_webhook_backoff.go /taskflow-stability-overlays/taskflow_webhook_backoff.go
COPY labs/taskflow/overrides/taskflow_webhook_backoff_test.go /taskflow-stability-overlays/taskflow_webhook_backoff_test.go
RUN TASKFLOW_STABILITY_PATCH_SCRIPT=/tmp/apply-taskflow-stability.py \
    TASKFLOW_STABILITY_REPO_ROOT=/src \
    TASKFLOW_STABILITY_TARGET=backend \
    TASKFLOW_VENDOR_SOURCE_ROOT=/src TASKFLOW_STABILITY_OVERLAY_ROOT=/taskflow-stability-overlays \
    python3 /tmp/test_taskflow_stability_overlay.py \
 && python3 /tmp/apply-taskflow-stability.py --target backend --root /src --overlays /taskflow-stability-overlays

COPY labs/taskflow/patches/apply-taskflow-zh-hant.py /tmp/apply-taskflow-zh-hant.py
COPY labs/taskflow/overrides/taskflow_zh_hant_language_test.go /taskflow-zh-hant/taskflow_zh_hant_language_test.go
RUN python3 /tmp/apply-taskflow-zh-hant.py --target backend --root /src --overlays /taskflow-zh-hant \
 && test -f /src/server/internal/handler/taskflow_zh_hant_language_test.go

FROM golang:1.26-alpine AS builder
ARG MULTICA_SOURCE_SHA
ARG VERSION=taskflow-parity
ARG COMMIT=${MULTICA_SOURCE_SHA}
ARG DATE=unknown
RUN apk add --no-cache git
WORKDIR /src
COPY --from=source /src /src
RUN cd server && go mod download
RUN cd server && CGO_ENABLED=0 go test ./cmd/server -run '^TestTaskFlowPoolBudget' -count=1
RUN cd server && CGO_ENABLED=0 go test ./internal/handler/taskflowcontract -count=1
RUN cd server && CGO_ENABLED=0 go test ./internal/handler -run '^TestTaskflowCodex' -count=1
RUN cd server && TASKFLOW_ROUTER_CONTRACT_ONLY=1 CGO_ENABLED=0 go test ./cmd/server -run '^TestTaskFlowZhugeRoutesInFinalRouter$' -count=1 \
 && TASKFLOW_LOCALE_CONTRACT_ONLY=1 CGO_ENABLED=0 go test ./internal/handler -run '^TestTaskFlowSupportedLocaleReplacement$' -count=1
RUN cd server && CGO_ENABLED=0 go test ./internal/auth -run TestZhugeCLIAuthorizationCode -count=1 \
 && CGO_ENABLED=0 go test ./internal/middleware -run TestZhugeCLIAuthorizationCode -count=1 \
 && CGO_ENABLED=0 go test ./internal/handler -run TestZhugeIssueCliToken -count=1
RUN cd server && CGO_ENABLED=0 go build -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" -o bin/server ./cmd/server
RUN cd server && CGO_ENABLED=0 go build -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" -o bin/multica ./cmd/multica
RUN cd server && CGO_ENABLED=0 go build -ldflags "-s -w" -o bin/migrate ./cmd/migrate
RUN cd server && CGO_ENABLED=0 go build -ldflags "-s -w" -o bin/maintenance ./cmd/maintenance
RUN cd server && CGO_ENABLED=0 go build -ldflags "-s -w" -o bin/backfill_task_usage_hourly ./cmd/backfill_task_usage_hourly
RUN cd server && CGO_ENABLED=0 go build -ldflags "-s -w" -o bin/backfill_codex_usage_cache ./cmd/backfill_codex_usage_cache

FROM alpine:3.21 AS runtime
RUN apk add --no-cache ca-certificates postgresql-client tzdata
WORKDIR /app
COPY --from=builder /src/server/bin/server .
COPY --from=builder /src/server/bin/multica .
COPY --from=builder /src/server/bin/migrate .
COPY --from=builder /src/server/bin/maintenance .
COPY --from=builder /src/server/bin/backfill_task_usage_hourly .
COPY --from=builder /src/server/bin/backfill_codex_usage_cache .
COPY --from=source /taskflow-staged-migrations/ ./migrations/
COPY --from=source /src/LICENSE /src/NOTICE ./
COPY labs/taskflow/overrides/taskflow-entrypoint.sh ./taskflow-entrypoint.sh
COPY labs/taskflow/overrides/taskflow-migrate.sh ./taskflow-migrate.sh
RUN sed -i 's/\r$//' taskflow-entrypoint.sh taskflow-migrate.sh \
 && chmod +x taskflow-entrypoint.sh taskflow-migrate.sh
ENV DISABLE_WORKSPACE_CREATION=true \
    MULTICA_CLOUD_URL= \
    DO_NOT_TRACK=1 \
    ANALYTICS_DISABLED=true
LABEL org.opencontainers.image.title="TaskFlow · Multica backend" \
      org.opencontainers.image.vendor="Index Labs (Hong Kong) Limited" \
      org.opencontainers.image.source="https://github.com/multica-ai/multica" \
      org.opencontainers.image.revision="8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec"
EXPOSE 8080
ENTRYPOINT ["./taskflow-entrypoint.sh"]
