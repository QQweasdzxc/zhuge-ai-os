diff --git a/labs/taskflow/overrides/taskflow_app_access.go b/labs/taskflow/overrides/taskflow_app_access.go
new file mode 100644
index 0000000000..25fbeddb74
--- /dev/null
+++ b/labs/taskflow/overrides/taskflow_app_access.go
@@ -0,0 +1,83 @@
+package auth
+
+// ZG-71. Dormant until TASKFLOW_APP_ACCESS_ENFORCE=on. Per-request App access decision for
+// TaskFlow human credentials. Targeted lookup by user id against the same
+// resolver as the Supabase gates; bounded last-good cache; fail closed.
+
+import (
+	"context"
+	"os"
+	"strings"
+	"sync"
+	"time"
+)
+
+type AppAccessLookup func(ctx context.Context, userID string) (bool, error)
+
+const (
+	appAccessFreshTTL   = 15 * time.Second // max revocation delay when DB is reachable
+	appAccessStaleGrace = 60 * time.Second // max time a known-allowed answer survives a lookup outage
+	appAccessLookupTime = 2 * time.Second
+)
+
+type appAccessEntry struct {
+	allowed bool
+	at      time.Time
+}
+
+var (
+	appAccessMu     sync.Mutex
+	appAccessFn     AppAccessLookup
+	appAccessCache  = map[string]appAccessEntry{}
+	appAccessNow    = time.Now
+	appAccessEnable = func() bool {
+		return strings.EqualFold(strings.TrimSpace(os.Getenv("TASKFLOW_APP_ACCESS_ENFORCE")), "on")
+	}
+)
+
+// SetAppAccessLookup is called once at startup with a DB-backed lookup.
+func SetAppAccessLookup(fn AppAccessLookup) {
+	appAccessMu.Lock()
+	defer appAccessMu.Unlock()
+	appAccessFn = fn
+	appAccessCache = map[string]appAccessEntry{}
+}
+
+// IsAppAccessDeniedUserID reports whether App access is Off for this user.
+// Dormant (false) unless TASKFLOW_APP_ACCESS_ENFORCE=on. When enforced:
+//   - fresh cache (<=15s) answers;
+//   - otherwise a 2s targeted lookup; success refreshes the cache;
+//   - lookup failure: only a previously ALLOWED answer younger than 60s
+//     is honoured; anything else (never seen, denied, expired, no lookup
+//     wired, invalid id) is denied. No creator bypass: the DB refuses to
+//     switch a creator or oneself Off, so none is needed.
+func IsAppAccessDeniedUserID(userID string) bool {
+	if !appAccessEnable() {
+		return false
+	}
+	id := strings.ToLower(strings.TrimSpace(userID))
+	if id == "" {
+		return true
+	}
+	now := appAccessNow()
+	appAccessMu.Lock()
+	fn := appAccessFn
+	e, ok := appAccessCache[id]
+	appAccessMu.Unlock()
+	if ok && now.Sub(e.at) <= appAccessFreshTTL {
+		return !e.allowed
+	}
+	if fn == nil {
+		return true
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), appAccessLookupTime)
+	defer cancel()
+	allowed, err := fn(ctx, id)
+	if err != nil {
+		return !(ok && e.allowed && now.Sub(e.at) <= appAccessStaleGrace)
+	}
+	appAccessMu.Lock()
+	appAccessCache[id] = appAccessEntry{allowed: allowed, at: now}
+	appAccessMu.Unlock()
+	return !allowed
+}
diff --git a/labs/taskflow/overrides/taskflow_app_access_lookup.go b/labs/taskflow/overrides/taskflow_app_access_lookup.go
new file mode 100644
index 0000000000..132e4560ec
--- /dev/null
+++ b/labs/taskflow/overrides/taskflow_app_access_lookup.go
@@ -0,0 +1,25 @@
+package main
+
+import (
+	"context"
+	"errors"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/multica-ai/multica/server/internal/auth"
+)
+
+// installTaskflowAppAccessLookup wires the targeted App access decision
+// (one boolean per user id, same resolver as the Supabase gates). It only
+// matters when TASKFLOW_APP_ACCESS_ENFORCE=on.
+func installTaskflowAppAccessLookup(pool *pgxpool.Pool) {
+	auth.SetAppAccessLookup(func(ctx context.Context, userID string) (bool, error) {
+		var allowed *bool
+		if err := pool.QueryRow(ctx, "select taskflow_gate.taskflow_app_access_decision($1::uuid)", userID).Scan(&allowed); err != nil {
+			return false, err
+		}
+		if allowed == nil {
+			return false, errors.New("app access decision returned null")
+		}
+		return *allowed, nil
+	})
+}
diff --git a/labs/taskflow/overrides/taskflow_app_access_test.go b/labs/taskflow/overrides/taskflow_app_access_test.go
new file mode 100644
index 0000000000..d830778c70
--- /dev/null
+++ b/labs/taskflow/overrides/taskflow_app_access_test.go
@@ -0,0 +1,107 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func setup(t *testing.T, fn AppAccessLookup) *time.Time {
+	t.Helper()
+	now := time.Unix(1000, 0)
+	appAccessNow = func() time.Time { return now }
+	appAccessEnable = func() bool { return true }
+	SetAppAccessLookup(fn)
+	t.Cleanup(func() { appAccessNow = time.Now })
+	return &now
+}
+
+func TestDormantWhenNotEnforced(t *testing.T) {
+	setup(t, func(context.Context, string) (bool, error) { return false, nil })
+	appAccessEnable = func() bool { return false }
+	if IsAppAccessDeniedUserID("u1") {
+		t.Fatal("dormant must not deny")
+	}
+}
+func TestOffDeniedOnDeniedAllowedPasses(t *testing.T) {
+	setup(t, func(_ context.Context, id string) (bool, error) { return id == "ok", nil })
+	if IsAppAccessDeniedUserID("ok") {
+		t.Fatal("allowed denied")
+	}
+	if !IsAppAccessDeniedUserID("off") {
+		t.Fatal("off allowed")
+	}
+	if !IsAppAccessDeniedUserID("") {
+		t.Fatal("empty id allowed")
+	}
+}
+func TestPendingNewIdentityNotAdmittedByCache(t *testing.T) {
+	// targeted lookup: a never-seen id is decided by the resolver, not by a list
+	setup(t, func(context.Context, string) (bool, error) { return false, nil })
+	if !IsAppAccessDeniedUserID("new-pending") {
+		t.Fatal("pending admitted")
+	}
+}
+func TestRevocationWithinFreshTTL(t *testing.T) {
+	allowed := true
+	now := setup(t, func(context.Context, string) (bool, error) { return allowed, nil })
+	if IsAppAccessDeniedUserID("u") {
+		t.Fatal()
+	}
+	allowed = false
+	*now = now.Add(appAccessFreshTTL + time.Second)
+	if !IsAppAccessDeniedUserID("u") {
+		t.Fatal("revocation not seen after TTL")
+	}
+}
+func TestOutageBoundedGraceThenClosed(t *testing.T) {
+	fail := false
+	now := setup(t, func(context.Context, string) (bool, error) {
+		if fail {
+			return false, errors.New("db down")
+		}
+		return true, nil
+	})
+	if IsAppAccessDeniedUserID("u") {
+		t.Fatal()
+	}
+	fail = true
+	*now = now.Add(appAccessFreshTTL + time.Second)
+	if IsAppAccessDeniedUserID("u") {
+		t.Fatal("grace not honoured")
+	}
+	*now = now.Add(appAccessStaleGrace)
+	if !IsAppAccessDeniedUserID("u") {
+		t.Fatal("not closed after grace")
+	}
+}
+func TestOutageNeverSeenOrDeniedStaysDenied(t *testing.T) {
+	setup(t, func(context.Context, string) (bool, error) { return false, errors.New("down") })
+	if !IsAppAccessDeniedUserID("never") {
+		t.Fatal()
+	}
+}
+func TestDeniedNotRescuedByOutage(t *testing.T) {
+	fail := false
+	now := setup(t, func(context.Context, string) (bool, error) {
+		if fail {
+			return false, errors.New("x")
+		}
+		return false, nil
+	})
+	if !IsAppAccessDeniedUserID("u") {
+		t.Fatal()
+	}
+	fail = true
+	*now = now.Add(appAccessFreshTTL + time.Second)
+	if !IsAppAccessDeniedUserID("u") {
+		t.Fatal("denied rescued")
+	}
+}
+func TestNoLookupWiredFailsClosed(t *testing.T) {
+	setup(t, nil)
+	if !IsAppAccessDeniedUserID("u") {
+		t.Fatal()
+	}
+}
