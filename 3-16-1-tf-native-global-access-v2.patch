+// One owner decision grants application access, never data ownership or per-feature roles.
+export function createAccessService({userId,getSession,baseUrl,anonKey,fetchImpl=fetch}){
+ if(!userId||!getSession||!baseUrl||!anonKey)throw Error('存取管理連線尚未完成');
+ const rpc=async(name,args={})=>{const session=await getSession();if(session?.user?.id!==userId||!session.access_token)throw Error('請先使用目前帳號完成連線');const response=await fetchImpl(new URL('/rest/v1/rpc/'+name,baseUrl),{method:'POST',headers:{apikey:anonKey,Authorization:'Bearer '+session.access_token,'Content-Type':'application/json'},body:JSON.stringify(args),cache:'no-store'});const result=await response.json();if(!response.ok)throw Error(response.status===403?'只有全站管理者可以管理使用權限':result?.message||'存取管理尚未完成');return result;};
+ const creator=async()=>{const value=await rpc('resolve_creator_capability');if(value?.is_creator!==true||value.user_id!==userId)throw Error('只有全站管理者可以管理使用權限');};
+ const list=async()=>{await creator();const rows=await rpc('list_app_access_applications');if(!Array.isArray(rows)||rows.some(x=>!x.applicant_user_id||typeof x.enabled!=='boolean'||typeof x.effective_allowed!=='boolean'))throw Error('權限清單尚未完整載入');return rows;};
+ return{list,async setEnabled(row,enabled,key){if(!row?.applicant_user_id||typeof enabled!=='boolean'||!key)throw Error('權限決定資料不完整');if(!enabled&&(row.is_creator||row.applicant_user_id===userId))throw Error('不能停用自己或全站管理者');await creator();await rpc('set_app_access_user_enabled',{p_applicant_user_id:row.applicant_user_id,p_enabled:enabled,p_note:null,p_idempotency_key:key});const next=await list();const saved=next.find(x=>x.applicant_user_id===row.applicant_user_id);if(!saved||saved.enabled!==enabled||saved.effective_allowed!==enabled)throw Error('尚未確認使用權限已更新，請重新確認');return next;}};
+}
