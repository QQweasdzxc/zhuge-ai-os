ummaryError}</small>}{statisticsNotice&&<small role="status">{statisticsNotice}</small>}<div className="suggest-list" tabIndex={0} aria-label="本頁工作建議，可上下捲動">{available.slice(sp*cardPageSize,sp*cardPageSize+cardPageSize).map(x=><article key={x.id} className={'suggest-card '+(chosen.includes(x.id)?'chosen':'')}><div className="suggest-title">{batchMode&&<label><input type="checkbox" aria-label={`這天做過 ${x.title}`} checked={chosen.includes(x.id)} onChange={e=>setChosen(e.target.checked?[...chosen,x.id]:chosen.filter(id=>id!==x.id))}/></label>}<button className="source-detail" aria-label={`查看 ${x.title} 推薦依據`} disabled={Boolean(loadError)} onClick={()=>{setEditing(x);open('source')}}>{x.title}</button></div><div className="card-bottom"><span>{duration(x.minutes)}</span><button className="quick-add" aria-label={`加入 ${x.title}`} disabled={Boolean(loadError)} onClick={()=>add([x])}>{busy&&pendingTitles.includes(x.title)?'正在加入…':busy&&persistedTitles.includes(x.title)?'已儲存':'加入'}</button><button aria-label={`調整 ${x.title}`} disabled={Boolean(loadError)} onClick={()=>editItem(x)}>調整</button></div></article>)}</div><Pager page={sp} pages={pages} onChange={setSuggestPage} label="建議"/>{batchMode&&<div className="batch"><span>已選 <b>{picked.length}</b> 項</span><button className="primary" disabled={!picked.length} onClick={()=>open('batch')}>一次確認加入</button></div>}</section><aside className="restore-rail"><span>{mode==='calendar'?'月曆模式':'核對模式'}</span>{mode==='calendar'&&<button onClick={()=>{setView('review');setActive('hours')}}><b>我的工時</b><span>{selectLabel}</span><strong>{shortHours(total)}</strong><small>{entries.length} 筆 · 展開明細 ‹</small></button>}<button onClick={()=>{setView('balanced');setActive('suggest')}}><b>工作建議</b><strong>{available.length} 項</strong><small>{picked.length?`已選 ${picked.length} 項 · `:''}展開建議 ‹</small></button><button className="return-layout" onClick={()=>setView('balanced')}>↙ 回三區填寫</button><small>選取日期與操作狀態<br/>切換後會保留</small></aside></div><footer className="statusbar"><span role="status">{notice||'點日期看明細；放大月曆，或收起建議專心核對。'}</span><small>{busy?(persistedTitles.length?'正在更新工作記憶…':'正在儲存…'):snapshot?.profile?'原有工時資料':'尚未載入工時資料'}</small></footer><div className="mobile-caveat">手機以區域切換；桌面可切換三種工作區。</div></main></div></fieldset>{loading&&!snapshot&&<div className="connection-state" role="status">正在載入原有工時資料…</div>}{loadError&&!snapshot&&<div className="connection-state" role="alert"><p>{loadError}</p><button onClick={refresh}>重新載入</button>{onConnectData&&['CONNECTION_REQUIRED','CONNECTION_REVOKED'].includes(loadErrorCode)&&<button onClick={onConnectData}>連接原有工時資料</button>}</div>}{!loading&&!loadError&&!snapshot?.profile&&<div className="connection-state"><p>請先完成原有「我的工作」設定，再開始填工時。</p><button onClick={onOpenLibrary}>前往我的工作</button></div>}</div>
