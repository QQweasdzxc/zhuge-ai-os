  {modal==='batch'&&<Modal busy={busy} title="確認選取日的工作" onClose={()=>setModal('')}><p>{selectLabel} · {picked.length} 項 · {duration(picked.reduce((s,x)=>s+x.minutes,0))}</p>{picked.map(x=><div className="review-row" key={x.id}><b>{x.title}</b><span>{x.start}-{time(mins(x.start)+x.minutes)} · {duration(x.minutes)}</span><small>ECP：{entryTypeFor(x)==='leave'?'休假不帶':x.ecp||'不指定'}{x.unavailable?' · 需調整時間':''}</small></div>)}{error&&<p className="error" role="alert">{error}</p>}<p className="muted">尚未加入的建議不列入工時；指定 Google 工時日曆已填的內容會直接同步。</p><div className="actions"><button className="primary" onClick={()=>add(picked)}>確認加入</button><button onClick={()=>setModal('')}>返回調整</button></div></Modal>}
  {(modal==='adjust'||modal==='manual'||modal==='edit-entry')&&editing&&<Modal busy={busy} title={modal==='edit-entry'?'編輯當日工時':modal==='manual'?'手動填寫工時':'調整工作建議'} onClose={()=>setModal('')}><p className="muted">0.5 小時制。只調整這筆，不改「我的工作」預設。</p>{form(editing,p=>{setError('');setEditing({...editing,...p,...(editing.suggestionId?{adjusted:true}:{})})})}<details className="detail"><summary>來源、ECP 與時間帶入</summary><p>{editing.source}。ECP 先帶預設；可改不指定。工作時間由個人上下班、午休與已填工時協助帶入，實際時間可自行修改。</p>{editing.unavailable&&<p>原有 6 又 2/3 小時沒有足夠連續空檔，請調整時間或時長。</p>}</details>{error&&<p className="error" role="alert">{error}</p>}<div className="actions">{modal==='adjust'&&<button onClick={saveEdit}>儲存這張建議</button>}{modal==='edit-entry'?<button className="primary" onClick={saveEntry}>儲存工時修改</button>:<button className="primary" onClick={()=>add([editing])}>確認並加入</button>}</div></Modal>}
