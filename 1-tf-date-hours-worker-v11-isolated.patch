+test('a cleared date source stays tombstoned while a later registration uses a fresh exact event identity',async()=>{const entries=new Map(),bindings=new Map(),events=new Map(),calls=[];const old={cloudId:'date-old',dateOnly:true,status:'deleted',date:'2026-11-12',at:'',hours:1.5,title:'same title',updatedAt:stamp,googleDeleteRequestedAt:stamp},fresh={...old,cloudId:'date-fresh',status:'completed',hours:1,updatedAt:'2026-11-12T09:21:00Z',googleDeleteRequestedAt:null};entries.set(old.cloudId,old);entries.set(fresh.cloudId,fresh);bindings.set(old.cloudId,{userId:'owner',calendarId:'calendar',entryId:old.cloudId,eventId:'old-event',eventEtag:'e1',entryUpdatedAt:'before'});events.set('old-event',{id:'old-event',etag:'e1',status:'confirmed'});const store={byEntry:async(_,__,id)=>bindings.get(id),entry:async(_,id)=>entries.get(id),assertLease:async()=>{},bind:async b=>bindings.set(b.entryId,b),eventIdentity:async(_,__,id)=>({id:'op-'+id,eventId:'event-'+id}),failure:async()=>{throw Error('unexpected failure')}};const provider={get:async(_,id)=>events.get(id),remove:async(_,id,etag)=>{assert.equal(etag,events.get(id).etag);events.set(id,{...events.get(id),status:'cancelled'});calls.push(['remove',id])},insert:async(_,event)=>{assert.ok(!events.has(event.id));const result={...event,etag:'fresh'};events.set(event.id,result);calls.push(['insert',event.id]);return result}};const sync=new GoogleWorklogSync({userId:'owner',calendarId:'calendar',worklog:{},store,provider,enabled:true});assert.equal((await sync.exportEntry(old)).status,'delete-synced');assert.equal((await sync.exportEntry(fresh)).status,'synced');assert.equal(events.get('old-event').status,'cancelled');assert.deepEqual(events.get('event-date-fresh').start,{date:fresh.date});assert.equal(events.get('event-date-fresh').extendedProperties.private.tq6_hours,'1');assert.deepEqual(calls,[['remove','old-event'],['insert','event-date-fresh']]);assert.equal((await sync.exportEntry(old)).status,'delete-synced');assert.equal((await sync.exportEntry(fresh)).status,'unchanged');assert.equal(calls.length,2);});
