+import test from 'node:test';import assert from 'node:assert/strict';import {dateHoursFromCloud,dateHoursEcp,dateHoursEvent,planDateHoursImport,validDay} from './date-hours.mjs';import {planSelectedCalendarEvent} from './calendar-mapping-candidate.mjs';
+const source={id:'canonical-issue',workspaceId:'workspace',title:'原任務',href:'/workspace/issues/canonical-issue',kind:'due'};
+const row={id:'native-row',user_uuid:'owner',work_date:'2026-11-30',started_at:null,ended_at:null,hours:1,title:'任務工時',date_only:true,taskflow_issue_ref:source,ecp_task_name_snapshot:'ECP關聯',updated_at:'2026-11-13T01:00:00Z'},entry=dateHoursFromCloud(row),binding={userId:'owner',calendarId:'selected',entryId:row.id,eventId:'native-event',eventEtag:'e1',entryUpdatedAt:row.updated_at};
+const event=()=>({...dateHoursEvent(entry,{userId:'owner',eventId:'native-event'}),etag:'e2',updated:'2026-11-13T02:00:00Z'}),plan=(extra={})=>planDateHoursImport({entry,event:event(),binding,userId:'owner',calendarId:'selected',...extra});
+test('cloud read is an actual date+hours record with no invented clock; source is separate from legacy task FK',()=>{assert.equal(entry.hours,1);assert.equal(entry.at,'');assert.equal(entry.dateOnly,true);assert.equal(entry.taskflowIssueRef.id,source.id);assert.equal(entry.taskUuid,undefined);assert.equal(dateHoursFromCloud({...row,date_only:false}),null);});
+test('ECP includes same date and exact 1.5h rather than dropping it, rounding it or making up a time',()=>{const output=dateHoursEcp({...entry,hours:1.5},{owner:'本人',department:'原部門'});assert.deepEqual([output.startAt,output.endAt,output.hours],['2026-11-30','2026-11-30',1.5]);assert.equal(output.ecpTask,'ECP關聯');assert.equal(output.ecpOwner,'本人');});
+test('Google date card spans one date, with explicit 1h metadata, no fake start or 24h busy block',()=>{const value=event();assert.deepEqual(value.start,{date:'2026-11-30'});assert.deepEqual(value.end,{date:'2026-12-01'});assert.equal(value.transparency,'transparent');assert.equal(value.extendedProperties.private.tq6_hours,'1');assert.equal(value.extendedProperties.private.tq6_kind,'date-worklog');assert.equal(value.start.dateTime,undefined);});
+test('only verified durable bindings import date cards; unbound or forged labels never create timed work',()=>{assert.equal(plan({binding:null}).code,'DATE_BINDING_REQUIRED');assert.equal(plan({binding:{...binding,entryId:'other'}}).code,'DATE_BINDING_REQUIRED');const forged={...event(),start:{dateTime:'2026-11-30T09:00:00+08:00'},end:{dateTime:'2026-11-30T10:00:00+08:00'}};assert.equal(planSelectedCalendarEvent({entry:null,event:forged,binding:null,userId:'owner',calendarId:'selected',selectedCalendarId:'selected'}).code,'DATE_BINDING_REQUIRED');});
