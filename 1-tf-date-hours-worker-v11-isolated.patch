+// Date-based hours are hours by the owner's rule, not a claim about clock time.
+const datePattern=/^\d{4}-\d{2}-\d{2}$/;
+export const validDay=value=>typeof value==='string'&&datePattern.test(value)&&Number.isFinite(new Date(value+'T12:00:00Z').getTime())&&new Date(value+'T12:00:00Z').toISOString().slice(0,10)===value;
+export function taskflowRef(value){if(!value||typeof value!=='object'||!value.id||!value.workspaceId||typeof value.title!=='string'||typeof value.href!=='string')return null;const prefix=value.href.split('/')[1];if(value.href!==`/${prefix}/issues/${encodeURIComponent(value.id)}`||!prefix||prefix==='.'||prefix==='..'||/[?#\\]/.test(value.href))return null;return {id:value.id,workspaceId:value.workspaceId,title:value.title,href:value.href,kind:value.kind||'due'};}
+export function dateHoursFromCloud(row){const ref=taskflowRef(row.taskflow_issue_ref);return row.date_only===true?{id:row.legacy_id||row.id,cloudId:row.id,date:row.work_date,at:'',hours:Number(row.hours),title:row.title||'',note:row.note||'',ecpTask:row.ecp_task_name_snapshot||'',entryType:'work',status:row.status||'completed',source:row.source||'ai-card',dateOnly:true,taskflowIssueRef:ref||undefined,updatedAt:row.updated_at||null}:null;}
+export function dateHoursEcp(entry,{owner,department}){if(!entry.dateOnly||!validDay(entry.date)||!Number.isFinite(entry.hours))throw Error('Invalid date-based hours');return {title:entry.title,ecpTask:entry.ecpTask||'',startAt:entry.date,endAt:entry.date,hours:entry.hours,ecpOwner:owner||'',ecpDepartment:department||'',dateOnly:true};}
+const tomorrow=day=>{if(!validDay(day))throw Error('Invalid date');const d=new Date(day+'T12:00:00Z');d.setUTCDate(d.getUTCDate()+1);return d.toISOString().slice(0,10)};
+export function dateHoursEvent(entry,{userId,eventId}){if(!entry.cloudId||!userId||!eventId||!entry.dateOnly||!validDay(entry.date)||!Number.isFinite(entry.hours)||entry.hours<=0||entry.hours>10)throw Error('Date-based worklog identity required');return {id:eventId,summary:entry.title,description:`登記工時：${entry.hours} 小時\n日期型工時，未指定開始時刻。${entry.taskflowIssueRef?'\nTF 原任務：'+entry.taskflowIssueRef.title:''}`,start:{date:entry.date},end:{date:tomorrow(entry.date)},transparency:'transparent',extendedProperties:{private:{tq6_kind:'date-worklog',tq6_owner:userId,tq6_entry:entry.cloudId,tq6_hours:String(entry.hours)}}};}
+export function planDateHoursImport({entry,event,binding,userId,calendarId,operationId}){const fail=(code,message)=>({action:'error',code,message,mutations:[]});if(!binding||!entry||binding.userId!==userId||binding.calendarId!==calendarId||binding.entryId!==entry.cloudId||binding.eventId!==event.id||!entry.dateOnly)return fail('DATE_BINDING_REQUIRED','日期型工時必須先有原始綁定，不以標題或標籤認定身分');if(event.status==='cancelled')return {action:'remote-deleted',mutations:[]};if(entry.status==='deleted')return {action:'local-deleted',mutations:[]};if(event.etag===binding.eventEtag)return {action:'unchanged',mutations:[]};if(!event.etag)return fail('STALE','缺少日曆版本');if(event.start?.dateTime||event.end?.dateTime||!validDay(event.start?.date)||event.end?.date!==tomorrow(event.start.date))return fail('DATE_KIND_CHANGED','日期型工時被改成有時刻或跨多日，原工時保留，請核對');const hours=Number(event.extendedProperties?.private?.tq6_hours);if(!Number.isFinite(hours)||hours<=0||hours>10)return fail('DATE_HOURS_REQUIRED','日期事件未保留有效工時，沒有將全天算成24小時');if(entry.updatedAt!==binding.entryUpdatedAt){const local=Date.parse(entry.updatedAt),remote=Date.parse(event.updated);if(Number.isFinite(local)&&Number.isFinite(remote)&&local>remote)return {action:'local-newer',mutations:[]};if(!Number.isFinite(local)||!Number.isFinite(remote)||local===remote)return {action:'conflict',code:'CONFLICT',message:'這筆日期工時在 TF 與日曆兩邊都有修改，請選擇保留版本，尚未覆寫。',conflict:{operationId,eventId:event.id,entryId:entry.cloudId,eventEtag:event.etag,entryUpdatedAt:entry.updatedAt||null,eventUpdated:event.updated||null,local:{title:entry.title,date:entry.date,at:'',hours:entry.hours,dateOnly:true},remote:{title:String(event.summary||'').trim(),date:event.start.date,at:'',hours,dateOnly:true}},mutations:[]};}return {action:'update-entry',proposed:{...entry,date:event.start.date,at:'',hours,title:String(event.summary||'').trim(),dateOnly:true},mutations:[]};}
