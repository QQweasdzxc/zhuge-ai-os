+      org.opencontainers.image.revision="8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec"
+USER nextjs
+EXPOSE 3000
+ENV PORT=3000 \
+    HOSTNAME=0.0.0.0
+CMD ["node", "apps/web/server.js"]
