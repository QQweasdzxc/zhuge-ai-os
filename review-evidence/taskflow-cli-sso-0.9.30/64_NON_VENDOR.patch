diff --git a/.gitattributes b/.gitattributes
new file mode 100644
index 00000000..2eda6099
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,3 @@
+# Keep the frozen upstream snapshot byte-identical; its historical whitespace
+# is retained as provenance and is not an application-source lint target.
+third_party/multica/** -whitespace
diff --git a/.github/workflows/taskflow-build-parity.yml b/.github/workflows/taskflow-build-parity.yml
new file mode 100644
index 00000000..eb6c4e31
--- /dev/null
+++ b/.github/workflows/taskflow-build-parity.yml
@@ -0,0 +1,66 @@
+name: TaskFlow Build Parity
+
+on:
+  push:
+    branches:
+      - main
+    paths:
+      - "third_party/multica/**"
+      - "labs/taskflow/**"
+      - "shared/components/zhuge-navigation.js"
+      - "tests/shared-navigation.test.js"
+      - "tests/taskflow-entry*.test.js"
+      - "tests/taskflow-cli-sso.test.js"
+      - ".github/workflows/taskflow-build-parity.yml"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  overlay-contract:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 2
+      - name: Check patch whitespace
+        run: git diff HEAD^ HEAD --check
+      - name: Verify TaskFlow overlay and fail-closed patch contract
+        run: PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s labs/taskflow/tests -v
+      - name: Verify TaskFlow navigation and authenticated entry contract
+        run: node --test tests/shared-navigation.test.js tests/taskflow-entry.test.js tests/taskflow-cli-sso.test.js
+
+  backend-image:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Build TaskFlow backend from repository-root context
+        shell: bash
+        run: |
+          set -o pipefail
+          docker build --pull --progress=plain \
+            -f labs/taskflow/Dockerfile.backend \
+            -t taskflow-multica-backend:parity . 2>&1 | tee /tmp/taskflow-backend-build.log
+          if grep -Eiq 'git clone https://github.com/multica-ai/multica([.]git)?' /tmp/taskflow-backend-build.log; then
+            echo "Unexpected Multica application-source clone in backend build log" >&2
+            exit 1
+          fi
+          grep -F "TASKFLOW_SOURCE_MODE=vendored SHA=8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec; upstream application source clone=disabled" /tmp/taskflow-backend-build.log
+
+  web-image:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Build TaskFlow web from repository-root context
+        shell: bash
+        run: |
+          set -o pipefail
+          docker build --pull --progress=plain \
+            -f labs/taskflow/Dockerfile.web \
+            -t taskflow-multica-web:parity . 2>&1 | tee /tmp/taskflow-web-build.log
+          if grep -Eiq 'git clone https://github.com/multica-ai/multica([.]git)?' /tmp/taskflow-web-build.log; then
+            echo "Unexpected Multica application-source clone in web build log" >&2
+            exit 1
+          fi
+          grep -F "TASKFLOW_SOURCE_MODE=vendored SHA=8db6cfe19ae6fd5c35ec71bd8fea42a3ef3861ec; upstream application source clone=disabled" /tmp/taskflow-web-build.log
