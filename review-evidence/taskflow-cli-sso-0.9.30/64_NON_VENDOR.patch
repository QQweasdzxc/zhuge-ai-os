+            tmpdir = Path(temp) / "patch-inputs"
+            router = root / "server/cmd/server/router.go"
+            router.parent.mkdir(parents=True)
+            router.write_text("package server\n// expected managed-only routes intentionally absent\n")
+            tmpdir.mkdir()
+            for name in (
