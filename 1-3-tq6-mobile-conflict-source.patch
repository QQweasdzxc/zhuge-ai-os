+++ b/labs/taskflow/tests/worklog-browser/conflicts.cjs
@@ -0,0 +1,7 @@
+const assert=require('node:assert/strict');
+const path=require('node:path'),fs=require('node:fs');
+const {chromium}=require('playwright');
+const output=path.resolve(process.env.WORKLOG_OUTPUT||'test-results');fs.mkdirSync(output,{recursive:true});
+const conflict={operationId:'op-synthetic',eventId:'g-synthetic',entryId:'r-synthetic',eventEtag:'g2',entryUpdatedAt:'2026-11-11T09:00:00Z',eventUpdated:'2026-11-11T09:00:00Z',updatedAt:'2026-11-11T10:00:00Z',local:{title:'測試部門會議準備與文件核對',date:'2026-11-11',at:'2026-11-11T09:00',hours:1},remote:{title:'Google測試會議與文件整理',date:'2026-11-11',at:'2026-11-11T10:00',hours:1.5}};
+(async()=>{const b=await chromium.launch({headless:true,args:['--no-sandbox'],...(process.env.CHROME_PATH?{executablePath:process.env.CHROME_PATH}:{})});try{for(const width of [320,390,1280]){const p=await b.newPage({viewport:{width,height:844},timezoneId:'Asia/Taipei'});await p.addInitScript(value=>{window.syntheticConflicts=[value]},conflict);await p.goto('http://127.0.0.1:4177/native.html');const d=p.getByRole('alertdialog',{name:'工時日曆衝突確認'});await d.waitFor();assert.ok(await d.getByText(conflict.local.title,{exact:true}).isVisible());assert.ok(await d.getByText(conflict.remote.title,{exact:true}).isVisible());assert.ok(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1));for(const name of ['保留 TF 這版','保留日曆這版']){const box=await d.getByRole('button',{name,exact:true}).boundingBox();assert.ok(box.height>=44);assert.ok(box.x>=0&&box.x+box.width<=width+1);}await p.screenshot({path:path.join(output,`tq6-conflicts-${width}.png`),fullPage:true});await d.getByRole('button',{name:'保留 TF 這版',exact:true}).click();await d.waitFor({state:'hidden'});assert.equal((await p.evaluate(()=>window.lastConflictChoice)).eventEtag,'g2');await p.close();}
+const p=await b.newPage({viewport:{width:390,height:844}});await p.addInitScript(()=>{window.failConflictRead=true});await p.goto('http://127.0.0.1:4177/native.html');await p.getByText('工時差異清單讀取失敗，尚無法確認是否有待處理衝突。既有資料沒有更改。').waitFor();await p.screenshot({path:path.join(output,'tq6-conflicts-read-failure.png'),fullPage:true});await p.evaluate(()=>window.failConflictRead=false);await p.getByRole('button',{name:'重新讀取差異',exact:true}).click();await p.getByRole('button',{name:'重新讀取差異',exact:true}).waitFor({state:'hidden'});console.log(JSON.stringify({widths:[320,390,1280],bothVersions:true,guardedChoice:true,readFailureVisible:true,retryWorks:true}));await p.close();}finally{await b.close();}})().catch(e=>{console.error(e);process.exitCode=1});
diff --git a/labs/taskflow/tests/worklog-browser/mobile-editor.cjs b/labs/taskflow/tests/worklog-browser/mobile-editor.cjs
new file mode 100644
index 0000000..edc561f
--- /dev/null
+++ b/labs/taskflow/tests/worklog-browser/mobile-editor.cjs
@@ -0,0 +1,35 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const {chromium, webkit} = require('playwright');
+const output = path.resolve(process.env.WORKLOG_OUTPUT || 'test-results');
+fs.mkdirSync(output, {recursive:true});
+(async () => {
+  const engine = process.env.WORKLOG_BROWSER === 'webkit' ? webkit : chromium;
+  const browser = await engine.launch({headless:true, ...(engine === chromium ? {args:['--no-sandbox'], ...(process.env.CHROME_PATH ? {executablePath:process.env.CHROME_PATH} : {})} : {})});
+  try {
+    for (const width of [320,390,1280]) {
+      const page = await browser.newPage({viewport:{width,height:844},timezoneId:'Asia/Taipei'});
+      const errors=[]; page.on('pageerror', e=>errors.push(e.message));
+      await page.goto('http://127.0.0.1:4177/native.html');
+      await page.getByText('正在載入原有工時資料…').waitFor({state:'hidden'});
+      if(width<1100) await page.getByRole('button',{name:'月曆',exact:true}).click();
+      await page.getByRole('button',{name:'11月1日 0h',exact:true}).click();
+      if(width<1100) await page.getByRole('button',{name:'我的工時 0',exact:true}).click();
+      await page.getByRole('button',{name:'＋ 手動',exact:true}).click();
+      const dialog=page.getByRole('dialog'); await dialog.waitFor();
+      const close=await dialog.getByRole('button',{name:'關閉',exact:true}).boundingBox();
+      assert.equal(close.width,44); assert.equal(close.height,44);
+      const start=await dialog.getByLabel('開始時間',{exact:true}).boundingBox();
+      const duration=await dialog.getByLabel('工時（分鐘）',{exact:true}).boundingBox();
+      if(width<420) assert.ok(duration.y >= start.y+start.height, JSON.stringify({start,duration}));
+      for (const bounds of [start,duration,close]) assert.ok(bounds.x>=0 && bounds.x+bounds.width<=width+1,JSON.stringify(bounds));
+      assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1));
+      await page.screenshot({path:path.join(output,`tq6-editor-${engine.name()}-${width}.png`),fullPage:true});
+      await dialog.getByRole('button',{name:'關閉',exact:true}).click();
+      assert.equal(await page.getByRole('dialog').count(),0); assert.deepEqual(errors,[]);
+      await page.close();
+    }
+    console.log(JSON.stringify({browser:engine.name(),widths:[320,390,1280],closeTarget44:true,timeInputsDoNotOverlap:true,noHorizontalOverflow:true,closeWorks:true}));
+  } finally {await browser.close();}
+})().catch(error=>{console.error(error);process.exitCode=1;});
