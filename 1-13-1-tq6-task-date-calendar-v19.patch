+import test from 'node:test';import assert from 'node:assert/strict';import{taskDateMarkers,loadTaskDueDates}from'./task-due-calendar.mjs';
+const options={workspaceId:'mine',from:'2026-12-01',to:'2027-02-01'};
+test('start, due, same date, boundaries, foreign workspace, no inferred span',()=>{const rows=[{id:'one',workspace_id:'mine',title:'one',start_date:'2026-12-31',due_date:'2027-01-02'},{id:'two',workspace_id:'mine',title:'two',start_date:'2027-01-01',due_date:'2027-01-01'},{id:'foreign',workspace_id:'other',title:'foreign',due_date:'2027-01-01'},{id:'none',workspace_id:'mine',title:'none'},{id:'outside',workspace_id:'mine',due_date:'2027-02-01'}];const result=taskDateMarkers([...rows,...rows],options);assert.equal(result.length,3);assert.deepEqual(result.map(x=>[x.id,x.date,x.kind]),[['one','2026-12-31','start'],['two','2027-01-01','both'],['one','2027-01-02','due']]);assert.ok(!result.some(x=>x.id==='one'&&x.date==='2027-01-01'))});
+test('both native filtered windows paginate and deduplicate safely',async()=>{let calls=[];const rows=Array.from({length:205},(_,i)=>({id:String(i),workspace_id:'mine',title:'Task'+i,start_date:'2026-12-31',due_date:'2026-12-31'}));const result=await loadTaskDueDates(async p=>{calls.push(p);return{issues:rows.slice(p.offset,p.offset+p.limit),total:rows.length}},options);assert.equal(result.length,205);assert.equal(calls.length,6);assert.deepEqual([...new Set(calls.map(x=>x.date_field))],['start_date','due_date']);assert.ok(calls.every(x=>x.workspace_id==='mine'&&!x.open_only))});
+test('partial failures and empty pagination are not reported as complete or empty',async()=>{await assert.rejects(loadTaskDueDates(async()=>({issues:[],total:20}),options),/完整/);await assert.rejects(loadTaskDueDates(async p=>{if(p.date_field==='due_date')throw Error('unavailable');return{issues:[],total:0}},options),/unavailable/)});
