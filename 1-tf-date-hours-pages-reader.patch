+function context(names,extra={}){const c={...extra};vm.createContext(c);for(const n of names)vm.runInContext(functions.get(n),c);return c;}
+const dated={id:'dated',cloudId:'source-row',date:'2026-11-12',at:'',hours:1.5,title:'日期工時',dateOnly:true,status:'completed',note:'private',ecpTask:'original'};
+test('legacy cloud adapter preserves exact date hours and no fake clock',()=>{const c=context(['entryFromCloud'],{formatTaipeiDateTimeInput:()=>{throw Error('cannot create fake time')},eventTypeNameMap:{WORK:'work'},eventTypeLabel:()=> '工作'});const e=c.entryFromCloud({id:'row',date_only:true,work_date:dated.date,started_at:null,hours:1.5,taskflow_issue_ref:{id:'original'}});assert.equal(e.at,'');assert.equal(e.dateOnly,true);assert.equal(e.hours,1.5);assert.equal(e.taskflowIssueRef.id,'original');});
+test('legacy date display and assistant lines never fall back to now',()=>{const c=context(['formatWorklogTimeRange','formatEntryLine'],{formatHumanDuration:h=>h+'小時'});assert.equal(c.formatWorklogTimeRange(dated),'日期工時（未指定時刻）');assert.match(c.formatEntryLine(dated),/1.5小時/);assert.doesNotMatch(c.formatEntryLine(dated),/00:00|09:00|NaN/);});
+test('legacy ECP keeps date strings and true hours alongside timed entries',()=>{const c=context(['workLogRowsForEcp'],{monthEntries:()=>[dated],profile:{ecpOwner:'owner',ecpDepartment:'department'},formatEcpDateTime:()=>{throw Error('date hours must not invent time')}});const[r]=c.workLogRowsForEcp();assert.equal(r.startAt,dated.date);assert.equal(r.endAt,dated.date);assert.equal(r.hours,1.5);assert.equal(r.ecpTask,'original');assert.ok(!JSON.stringify(r).includes('private'));});
+test('legacy dated rows count in monthly calendar but do not occupy a clock slot',()=>{const c=context(['workIntervalsForDate','worklogTimeConflicts','worklogCalendarCells'],{entries:[dated],key:d=>d.toISOString().slice(0,10),entryStartMinutes:()=>{throw Error('date has no start minute')},entryEndMinutes:()=>{throw Error('date has no end minute')}});assert.equal(c.workIntervalsForDate(dated.date).length,0);c.entryStartMinutes=()=>540;assert.equal(c.worklogTimeConflicts({...dated,dateOnly:false,id:'timed'}),false);const day=c.worklogCalendarCells(2026,10).find(x=>x.dateKey===dated.date);assert.equal(day.hours,1.5);});
+test('legacy stale capture is read-only, original data is neither deleted nor silently saved as timed',()=>{const c=context(['capture'],{entries:[dated],editingEntryId:'dated',captureSeed:null,escapeHtml:x=>String(x),formatHumanDuration:h=>h+'小時'});const html=c.capture();assert.match(html,/請在 TF/);assert.doesNotMatch(html,/datetime-local|id="saveEntry"/);const ds=fs.readFileSync(path.join(root,'shared/api/data-service.js'),'utf8');assert.match(ds,/async saveEntry\(item\) \{\s+if \(item\?\.dateOnly\) throw/);assert.match(ds,/async deleteEntry\(entry\) \{\s+if \(entry\?\.dateOnly\) throw/);assert.equal((ds.match(/entries\.filter\(e => !e\.dateOnly && e\.status !== "deleted"\)/g)||[]).length,2);});
