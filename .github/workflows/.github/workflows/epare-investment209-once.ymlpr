name: Prepare reviewed investment209 source only
on:
  push:
    branches: [review/investment-read-step-up-20261118]
    paths: [.github/workflows/prepare-investment209-once.yml]
permissions:
  contents: write
jobs:
  prepare:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Apply exact hashed reviewed source without deployment
        run: |
          test "$(git merge-base HEAD origin/main)" = "3954fd4ff96026749087d5b0d3329fcf9daf3d3d"
          python3 - <<'PYFILES'
          import pathlib,hashlib,gzip,json,base64
          root=pathlib.Path('.')
          inputs=list(root.glob('*investment209-exact-files.json.gz'))
          assert len(inputs)==1
          blob=inputs[0].read_bytes()
          assert hashlib.sha256(blob).hexdigest()=='0f4f90d03ab09882c6105a99506da53e75b64c6aa3865c8b9337749dfd6e685c'
          files=json.loads(gzip.decompress(blob))
          assert len(files)==33
          for name,data in files.items():
            dest=root/name
            assert dest.resolve().is_relative_to(root.resolve())
            assert not name.startswith(('.github/','supabase/','ZG-ERP/'))
            dest.parent.mkdir(parents=True,exist_ok=True)
            dest.write_bytes(base64.b64decode(data,validate=True))
          inputs[0].unlink()
          PYFILES
          git config user.name github-actions[bot]
          git config user.email 41898282+github-actions[bot]@users.noreply.github.com
          git add -A
          git diff --cached --check
          git commit -m 'Apply reviewed read-only MFA step-up209 source only'
          git push origin HEAD:review/investment-read-step-up-20261118
