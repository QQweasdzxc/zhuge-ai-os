+import test from 'node:test';import assert from 'node:assert/strict';import{createAccessService}from './taskflow-access-service.mjs';
+function fixture({sessionOwner='owner',creator=true,rows=[{applicant_user_id:'member',enabled:false,effective_allowed:false}],fail=false}={}){const calls=[];const service=createAccessService({userId:'owner',baseUrl:'https://synthetic.invalid',anonKey:'not-real',getSession:async()=>({user:{id:sessionOwner},access_token:'synthetic'}),fetchImpl:async(url,opt)=>{const name=url.pathname.split('/').at(-1);calls.push([name,JSON.parse(opt.body)]);if(name==='set_app_access_user_enabled'){rows[0].enabled=JSON.parse(opt.body).p_enabled;rows[0].effective_allowed=rows[0].enabled;}return {ok:!fail,status:fail?403:200,json:async()=>name==='resolve_creator_capability'?{user_id:'owner',is_creator:creator}:name==='list_app_access_applications'?rows:{enabled:true}}}});return{calls,service,rows};}
+test('load only reads existing creator and members, no ensure or decisions',async()=>{const f=fixture();assert.equal((await f.service.list()).length,1);assert.deepEqual(f.calls.map(x=>x[0]),['resolve_creator_capability','list_app_access_applications']);});
+test('one confirmed decision is global, preserves subject and idempotency',async()=>{const f=fixture();await f.service.setEnabled(f.rows[0],true,'same-operation');assert.deepEqual(f.calls.find(x=>x[0]==='set_app_access_user_enabled')[1],{p_applicant_user_id:'member',p_enabled:true,p_note:null,p_idempotency_key:'same-operation'});assert.equal(f.calls.at(-1)[0],'list_app_access_applications');});
+test('never borrows another account session',async()=>{const f=fixture({sessionOwner:'other'});await assert.rejects(()=>f.service.list());assert.equal(f.calls.length,0);});
+test('workspace owner is not global creator',async()=>{const f=fixture({creator:false});await assert.rejects(()=>f.service.list());assert.equal(f.calls.length,1);await assert.rejects(()=>f.service.setEnabled(f.rows[0],true,'operation'));assert.equal(f.calls.some(x=>x[0].startsWith('set_')),false);});
+test('self and creator cannot be disabled',async()=>{const f=fixture();await assert.rejects(()=>f.service.setEnabled({applicant_user_id:'owner'},false,'x'));await assert.rejects(()=>f.service.setEnabled({applicant_user_id:'creator',is_creator:true},false,'x'));assert.equal(f.calls.length,0);});
+test('incomplete responses and denied API never mean empty or saved',async()=>{for(const options of[{rows:null},{rows:[{applicant_user_id:'member'}]},{fail:true}]){const f=fixture(options);await assert.rejects(()=>f.service.list());}});
