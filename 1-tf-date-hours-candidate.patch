@@ -0,0 +1,58 @@
+name: TaskFlow Date Hours Qualification
+on:
+  push:
+    branches: [review/tf-date-hours-20261113]
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  date-hours:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+      - run: npm ci --ignore-scripts
+      - name: Source and overlay contracts
+        run: |
+          git diff HEAD^ HEAD --check
+          PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s labs/taskflow/tests -v
+          npm run test:worklog
+          node --test tests/worklog-date-hours-compat.test.js tests/worklog-sprint-3.test.js tests/worklog-sync-status-flicker.test.js
+      - name: Isolated SQL and worker bundle
+        run: |
+          npm ci --ignore-scripts --prefix labs/taskflow/tests/worklog-server
+          cd labs/taskflow/tests/worklog-server
+          node sql-check.mjs
+          node date-hours-check.mjs
+          npm run test:bundle
+      - name: Native and legacy browser fixture
+        run: |
+          sudo mkdir -p /downloads
+          sudo chmod 777 /downloads
+          npm ci --ignore-scripts --prefix labs/taskflow/tests/worklog-browser
+          cd labs/taskflow/tests/worklog-browser
+          npx tsc --noEmit
+          npx playwright install --with-deps chromium
+          export CHROME_PATH=$(node -e 'process.stdout.write(require("playwright").chromium.executablePath())')
+          npx vite --host 127.0.0.1 --port 4177 > /tmp/vite-4177.log 2>&1 &
+          server=$!
+          trap 'kill $server' EXIT
+          for i in $(seq 1 30); do if curl -fsS http://127.0.0.1:4177/native.html > /tmp/native-fixture.html; then break; fi; sleep 1; done
+          for test in native-wrapper mobile-editor task-markers task-dates visible-range export-parity editor-parity; do node "$test.cjs"; done
+          node legacy-date-hours.cjs
+          npx vite --host 127.0.0.1 --port 4180 > /tmp/vite-4180.log 2>&1 &
+          date_server=$!
+          trap 'kill $server $date_server' EXIT
+          for i in $(seq 1 30); do if curl -fsS http://127.0.0.1:4180/native.html > /tmp/date-fixture.html; then break; fi; sleep 1; done
+          node date-hours.cjs
+  web-image:
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@v4
+      - name: Build exact native Web image without deployment
+        run: docker build --progress=plain -f labs/taskflow/Dockerfile.web -t taskflow-date-hours-web:qualification .
